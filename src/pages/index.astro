---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CycleTile from '../components/CycleTile.astro';
import CycleName from '../components/CycleName.astro';
import LatestStrip from '../components/LatestStrip.astro';
import InitialText from '../components/InitialText.astro';
import TeaserAccordion from '../components/TeaserAccordion.astro';
import { cycles, site } from '../lib/data';
import { absoluteSiteUrl, assetPath, withBase } from '../lib/paths';
import { imageAsset } from '../lib/image-assets';
import '../styles/home-desktop.css';
import '../styles/home-cycle-cards.css';

const headerImage = imageAsset(site.headerCover);
const headerCover = site.headerCover ? assetPath(site.headerCover) : '';
// 768px prevents high-density mobile screens from jumping from the 640px
// source straight to 960px for a roughly 412px-wide viewport.
const heroWidths = [640, 768, 960, 1280, 1440, 1600, 1800];
// Keep both reveal layers identical so they share one image download.
const heroQuality = 45;
const homeDescription = 'Short stories, flash fiction and poems by Alexei Raymond. Read full texts, explore interconnected story cycles, and find work published in literary journals.';
const homeUrl = absoluteSiteUrl('', Astro.site);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${homeUrl}#website`,
  name: site.author,
  url: homeUrl,
  description: homeDescription,
  inLanguage: 'en',
  publisher: { '@id': `${homeUrl}#person` }
};
---

<BaseLayout
  title={`${site.author} | Short Fiction, Flash Fiction & Poetry`}
  description={homeDescription}
  structuredData={websiteSchema}
  bodyClass="home-page"
>
  <section class="hero" aria-labelledby="home-title" data-color-reveal>
    {headerImage ? (
      <>
        <Picture
          class="hero-backdrop hero-backdrop--mono"
          src={headerImage}
          alt=""
          widths={heroWidths}
          width={1800}
          sizes="100vw"
          formats={['avif']}
          fallbackFormat="webp"
          quality={heroQuality}
          priority
        />
        <Picture
          class="hero-backdrop hero-color-reveal"
          src={headerImage}
          alt=""
          widths={heroWidths}
          width={1800}
          sizes="100vw"
          formats={['avif']}
          fallbackFormat="webp"
          quality={heroQuality}
          loading="eager"
          decoding="async"
          aria-hidden="true"
        />
        <div class="hero-scrim" aria-hidden="true"></div>
      </>
    ) : headerCover ? (
      <>
        <img class="hero-backdrop hero-backdrop--mono" src={headerCover} alt="" fetchpriority="high" />
        <img class="hero-backdrop hero-color-reveal" src={headerCover} alt="" aria-hidden="true" loading="eager" />
        <div class="hero-scrim" aria-hidden="true"></div>
      </>
    ) : null}
    <div class="page-shell hero-layout">
      <div class="hero-content">
        <h1 class="page-heading" id="home-title" data-title-shimmer>{site.author}</h1>
        <p class="hero-kicker">Short fiction, flash, poems, and the pursuit of unspeakable&nbsp;loveliness.</p>
        <a class="hero-start" href={withBase('selected/')}><span><InitialText text="Selected Works" /></span> <span class="home-link-arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="hero-teaser-feed">
        <TeaserAccordion />
      </div>
    </div>

    <style>
      .hero-layout {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.85fr);
        align-items: start;
        gap: clamp(36px, 5vw, 72px);
      }

      .hero-teaser-feed {
        position: relative;
        z-index: 3;
        width: min(100%, 26rem);
        justify-self: end;
      }

      @media (min-width: 861px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
        .hero-scrim::after {
          content: '';
          position: absolute;
          inset: 0;
          pointer-events: none;
          opacity: 0;
          transition: opacity 220ms ease;
          background: radial-gradient(
            ellipse var(--quote-scrim-radius) 150px at var(--quote-scrim-x) var(--quote-scrim-y),
            rgba(10, 10, 10, 0.42) 0%,
            rgba(10, 10, 10, 0.36) 44%,
            rgba(10, 10, 10, 0.19) 68%,
            transparent 100%
          );
          -webkit-mask-image: var(--hero-reveal-mask);
          mask-image: var(--hero-reveal-mask);
        }

        .hero.is-color-reveal-active .hero-scrim::after {
          opacity: 1;
        }

        .hero.is-color-reveal-active .hero-teaser-feed :global(.teaser-accordion-line),
        .hero.is-color-reveal-active .hero-teaser-feed :global(.teaser-accordion-source) {
          color: color-mix(in srgb, var(--text-soft), var(--text) var(--quote-lift, 0%));
        }
      }

      @media (max-width: 860px) {
        .hero-layout {
          grid-template-columns: minmax(0, 1fr);
          gap: 32px;
        }

        .hero-teaser-feed {
          width: min(100%, 28rem);
        }
      }

      @media (max-width: 640px) {
        .hero-teaser-feed {
          justify-self: start;
        }
      }
    </style>

    <button class="hero-sound-toggle" type="button" data-sound-toggle aria-pressed="false" aria-label="Sound off">
      <span class="hero-sound-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M2.5 9v6h4l5 4V5l-5 4h-4z"></path>
          <path class="hero-sound-wave" d="M14 9.5c1.3 1.4 1.3 3.6 0 5"></path>
          <path class="hero-sound-wave hero-sound-wave--extra" d="M17 7c2.6 2.8 2.6 7.2 0 10"></path>
          <path class="hero-sound-wave hero-sound-wave--extra" d="M20 4.5c3.9 4.2 3.9 10.8 0 15"></path>
        </svg>
      </span>
    </button>
    <audio data-ambient-audio src={assetPath('audio/ambient.mp3')} loop preload="none"></audio>
  </section>

  <LatestStrip />

  <section class="page-shell home-cycles" aria-labelledby="cycles-title">
    <div class="section-head">
      <h2 id="cycles-title">Cycles</h2>
      <p class="section-note">Story cycles flow in and out of one another; an interconnected whole&nbsp;emerges.</p>
    </div>
    <div class="cycle-grid home-cycle-grid" data-home-cycle-focus data-home-cycle-fan data-cycle-flux>
      {cycles.map((cycle) => (
        <CycleTile cycle={cycle} />
      ))}
    </div>
    <nav class="home-cycle-index" aria-label="Story cycle index">
      {cycles.filter((cycle) => !cycle.disabled).map((cycle) => (
        <a href={withBase(`cycles/${cycle.id}/`)} data-home-cycle-link={cycle.id}>
          <span class="home-cycle-index-numeral" aria-hidden="true"></span><CycleName name={cycle.name} />
        </a>
      ))}
    </nav>
  </section>

  <script>
    import { setRevealPosition, trackColorReveal } from '../scripts/color-reveal';

    const hero = document.querySelector<HTMLElement>('.hero[data-color-reveal]');
    const layer = hero?.querySelector<HTMLElement>('.hero-color-reveal');
    const scrim = hero?.querySelector<HTMLElement>('.hero-scrim');
    if (hero && layer && scrim) {
      const quote = hero.querySelector<HTMLElement>('.hero-teaser-feed');
      const desktopQuote = window.matchMedia('(min-width: 861px)');
      trackColorReveal(hero, (x, y, rect) => {
        const quoteRect = desktopQuote.matches ? quote?.getBoundingClientRect() : undefined;
        setRevealPosition(layer, x, y, rect);
        if (quote && quoteRect?.height) {
          const quoteX = quoteRect.left - rect.left + quoteRect.width / 2;
          const quoteY = quoteRect.top - rect.top + quoteRect.height / 2 - 6;
          const distance = Math.hypot(x - quoteX, y - quoteY);
          const lift = Math.max(0, Math.min(1, (390 - distance) / 160));
          setRevealPosition(scrim, x, y, rect);
          scrim.style.setProperty('--quote-scrim-x', `${quoteX}px`);
          scrim.style.setProperty('--quote-scrim-y', `${quoteY}px`);
          scrim.style.setProperty('--quote-scrim-radius', `${quoteRect.width / 2 + 135}px`);
          quote.style.setProperty('--quote-lift', `${lift * 100}%`);
        }
      }, { resizeTarget: quote ?? undefined });
    }
  </script>
  <script>
    /* Homepage local ambient sound toggle. */
    const soundButton = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');
    const ambientAudio = document.querySelector<HTMLAudioElement>('[data-ambient-audio]');

    if (soundButton && ambientAudio) {
      const toggle = soundButton;
      const audio = ambientAudio;
      audio.volume = 0.32;
      const labels = {
        off: 'Sound off',
        starting: 'Sound ...',
        playing: 'Sound on',
        unavailable: 'Sound unavailable',
      };
      let soundState: keyof typeof labels = 'off';
      let playbackAttempt = 0;

      function setSoundState(next: keyof typeof labels) {
        soundState = next;
        toggle.setAttribute('aria-pressed', String(next === 'playing'));
        toggle.setAttribute('aria-label', labels[next]);
      }

      audio.addEventListener('playing', () => {
        if (!audio.paused) setSoundState('playing');
      });
      audio.addEventListener('pause', () => {
        if (!audio.paused) return;
        playbackAttempt += 1;
        if (soundState !== 'unavailable') setSoundState('off');
      });
      audio.addEventListener('error', () => {
        if (!audio.error) return;
        playbackAttempt += 1;
        setSoundState('unavailable');
      });

      toggle.addEventListener('click', async () => {
        if (soundState === 'starting' || soundState === 'playing' || !audio.paused) {
          playbackAttempt += 1;
          setSoundState('off');
          audio.pause();
          return;
        }

        const attempt = ++playbackAttempt;
        setSoundState('starting');
        try {
          if (audio.error) audio.load();
          await audio.play();
          if (attempt === playbackAttempt && !audio.paused) setSoundState('playing');
        } catch (error) {
          if (attempt !== playbackAttempt) return;
          setSoundState(error instanceof DOMException && error.name === 'AbortError' ? 'off' : 'unavailable');
        }
      });
    }
  </script>

  <script>
    /* Homepage desktop cycle fan focus. */
    (() => {
      const desktop = window.matchMedia('(min-width: 861px)');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const fanElement = document.querySelector<HTMLElement>('[data-home-cycle-fan]');

      if (!fanElement) return;

      const fan: HTMLElement = fanElement;

      const tiles = Array.from(fan.querySelectorAll<HTMLElement>('.tile'));
      if (!tiles.length) return;

      // Index links share the existing focus state. Keep them outside the fan
      // so the liquid renderer still measures exactly the same eight cards.
      const cycleIndex = fan.parentElement?.querySelector<HTMLElement>('.home-cycle-index');
      const indexLinks = Array.from(cycleIndex?.querySelectorAll<HTMLAnchorElement>('[data-home-cycle-link]') ?? []);
      const tileForLink = (link?: HTMLAnchorElement) =>
        link ? tiles.find((tile) => tile.dataset.cycleId === link.dataset.homeCycleLink) : undefined;

      // Match tab order to the layout while leaving the tablet index below the cards.
      function placeIndex() {
        if (!cycleIndex || desktop.matches === (cycleIndex.nextElementSibling === fan)) return;

        const focusedLink = indexLinks.find((link) => link === document.activeElement);
        if (desktop.matches) fan.before(cycleIndex);
        else fan.after(cycleIndex);
        focusedLink?.focus({ preventScroll: true });
      }

      function setFanFocus(focusedTile?: HTMLElement) {
        const liftTile = reducedMotion.matches ? undefined : focusedTile;
        tiles.forEach((tile) => {
          tile.classList.toggle('is-fan-focus', tile === liftTile);
        });
        indexLinks.forEach((link) => {
          link.classList.toggle('is-fan-highlight', link.dataset.homeCycleLink === focusedTile?.dataset.cycleId);
        });
      }

      function restoreFanFocus() {
        if (!desktop.matches) {
          setFanFocus();
          return;
        }

        /* Only genuine pointer or keyboard focus should lift a card. */
        const hoverTile = tiles.find((tile) => tile.matches(':hover'));
        const keyboardTile = tiles.find((tile) => tile.matches(':focus-visible'));
        const hoverLink = indexLinks.find((link) => link.matches(':hover'));
        const keyboardLink = indexLinks.find((link) => link.matches(':focus-visible'));
        setFanFocus(hoverTile ?? tileForLink(hoverLink) ?? keyboardTile ?? tileForLink(keyboardLink));
      }

      let entranceTimer = 0;
      let entranceObserver: IntersectionObserver | undefined;

      function finishFanEntrance() {
        window.clearTimeout(entranceTimer);
        entranceObserver?.disconnect();
        fan.classList.remove('is-fan-pending', 'is-fan-entering');
      }

      function playFanEntrance() {
        fan.classList.remove('is-fan-pending');
        fan.classList.add('is-fan-entering');

        /* 950ms animation + 135ms outermost delay: hand over right as the
           last ring lands, with no dead beat before the focus lift. */
        entranceTimer = window.setTimeout(() => {
          finishFanEntrance();
          restoreFanFocus();
        }, 1100);
      }

      function armFanEntrance() {
        if (!desktop.matches || reducedMotion.matches) {
          restoreFanFocus();
          return;
        }

        fan.classList.add('is-fan-pending');
        setFanFocus();

        if (!('IntersectionObserver' in window)) {
          playFanEntrance();
          return;
        }

        entranceObserver = new IntersectionObserver(
          (entries) => {
            if (!fan.classList.contains('is-fan-pending') || !entries.some((entry) => entry.isIntersecting)) return;

            entranceObserver?.disconnect();
            entranceTimer = window.setTimeout(playFanEntrance, 240);
          },
          {
            rootMargin: '0px 0px -12% 0px',
            threshold: 0.18,
          },
        );

        entranceObserver.observe(fan);
      }

      tiles.forEach((tile) => {
        tile.addEventListener('pointerenter', () => {
          if (
            desktop.matches &&
            !fan.classList.contains('is-fan-pending') &&
            !fan.classList.contains('is-fan-entering')
          ) {
            setFanFocus(tile);
          }
        });

        tile.addEventListener('pointerleave', () => {
          if (tile.matches(':focus-visible')) return;
          indexLinks.find((link) => link.dataset.homeCycleLink === tile.dataset.cycleId)
            ?.classList.remove('is-fan-highlight');
        });

        tile.addEventListener('focusin', () => {
          if (desktop.matches) setFanFocus(tile);
        });
      });

      fan.addEventListener('pointerleave', restoreFanFocus);
      fan.addEventListener('focusout', (event) => {
        const nextTarget = event.relatedTarget;

        if (!(nextTarget instanceof Node) || !fan.contains(nextTarget)) {
          restoreFanFocus();
        }
      });

      indexLinks.forEach((link) => {
        function focusLinkedTile() {
          if (!desktop.matches) return;
          finishFanEntrance();
          setFanFocus(tileForLink(link));
        }

        link.addEventListener('pointerenter', focusLinkedTile);
        link.addEventListener('focusin', () => {
          if (link.matches(':focus-visible')) focusLinkedTile();
        });
        link.addEventListener('pointerleave', () => requestAnimationFrame(restoreFanFocus));
        link.addEventListener('focusout', () => requestAnimationFrame(restoreFanFocus));
      });

      desktop.addEventListener('change', () => {
        finishFanEntrance();
        placeIndex();
        restoreFanFocus();
      });
      reducedMotion.addEventListener('change', () => {
        if (reducedMotion.matches) finishFanEntrance();
        restoreFanFocus();
      });

      placeIndex();
      armFanEntrance();
    })();
  </script>

  <script>
    /* Homepage mobile cycle loop and focus color. */
    (() => {
      const media = window.matchMedia('(max-width: 640px)');
      const gridElement = document.querySelector<HTMLElement>('[data-home-cycle-focus]');

      if (!gridElement) return;

      const grid: HTMLElement = gridElement;

      const tiles = Array.from(grid.querySelectorAll<HTMLElement>(':scope > .tile'));
      if (!tiles.length) return;

      let loop: { ordered: HTMLElement[]; before: HTMLElement[]; after: HTMLElement[] } | undefined;
      let geometry: { centers: number[]; viewportHalf: number; period: number } | undefined;
      let centeredCycleId: string | undefined;
      let focused: HTMLElement[] = [];
      let gridVisible = false;
      let frame = 0;

      function clearFocus() {
        focused.forEach((tile) => tile.classList.remove('is-mobile-focus'));
        focused = [];
      }

      function createLoop() {
        // Match the existing visual order, which differs from the desktop fan.
        const visualOrder = tiles.map((tile) => ({ tile, order: Number(getComputedStyle(tile).order) }));
        visualOrder.sort((a, b) => a.order - b.order);
        const ordered = visualOrder.map(({ tile }) => tile);
        const copySet = (groupOrder: number) => ordered.map((tile) => {
          const copy = tile.cloneNode(true) as HTMLElement;
          copy.style.order = String(groupOrder);
          copy.setAttribute('aria-hidden', 'true');
          if (copy instanceof HTMLAnchorElement) copy.tabIndex = -1;
          return copy;
        });

        const before = copySet(visualOrder[0].order - 1);
        const after = copySet(visualOrder[visualOrder.length - 1].order + 1);
        const position = grid.scrollLeft;
        loop = { ordered, before, after };
        grid.prepend(...before);
        grid.append(...after);
        const { centers, viewportHalf, period } = measureGeometry();
        const restoredIndex = ordered.findIndex((tile) => tile.dataset.cycleId === centeredCycleId);
        const left = restoredIndex >= 0 ? centers[restoredIndex] - viewportHalf : position + period;
        grid.scrollTo({ left, behavior: 'instant' });
      }

      function measureGeometry() {
        const gridBox = grid.getBoundingClientRect();
        const scrollLeft = grid.scrollLeft;
        const boxes = (loop?.ordered ?? tiles).map((tile) => tile.getBoundingClientRect());
        geometry = {
          centers: boxes.map((box) => box.left - gridBox.left + scrollLeft + box.width / 2),
          viewportHalf: gridBox.width / 2,
          period: loop ? loop.after[0].getBoundingClientRect().left - boxes[0].left : 0,
        };
        return geometry;
      }

      function invalidateGeometry() {
        geometry = undefined;
        scheduleUpdate();
      }

      function recenterLoop() {
        if (!media.matches || !gridVisible || !loop) return;

        const { period: width } = geometry ?? measureGeometry();
        if (!width) return;
        const position = grid.scrollLeft;
        // Wait for the native swipe and snap to finish, then shift to the
        // same view in the original set. Allow for fractional snap positions.
        if (position < width - 1) {
          grid.scrollTo({ left: position + width, behavior: 'instant' });
        } else if (position >= 2 * width - 1) {
          grid.scrollTo({ left: position - width, behavior: 'instant' });
        }
      }

      function updateFocus() {
        frame = 0;
        if (!media.matches || !gridVisible) {
          clearFocus();
          return;
        }

        if (!loop && tiles.length > 1) createLoop();

        const { centers, viewportHalf, period } = geometry ?? measureGeometry();
        const carouselCenter = grid.scrollLeft + viewportHalf;
        const ordered = loop?.ordered ?? tiles;
        let closestIndex = 0;
        let closestDistance = Infinity;

        centers.forEach((center, index) => {
          const delta = center - carouselCenter;
          const distance = Math.abs(period ? delta - Math.round(delta / period) * period : delta);

          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });

        if (focused[0] === ordered[closestIndex]) return;
        centeredCycleId = ordered[closestIndex].dataset.cycleId;
        clearFocus();
        // Keep the visual state matched when a copy becomes an original.
        focused = [ordered[closestIndex]];
        if (loop) focused.push(loop.before[closestIndex], loop.after[closestIndex]);
        focused.forEach((tile) => tile.classList.add('is-mobile-focus'));
      }

      function scheduleUpdate() {
        // Keep loop setup and measurements out of the opening render.
        if (!media.matches || !gridVisible || frame) return;
        frame = requestAnimationFrame(updateFocus);
      }

      function setGridVisible(visible: boolean) {
        if (gridVisible === visible) return;
        gridVisible = visible;

        if (gridVisible) {
          invalidateGeometry();
          return;
        }

        cancelAnimationFrame(frame);
        frame = 0;
        clearFocus();
      }

      grid.addEventListener('scroll', scheduleUpdate, { passive: true });
      if (Reflect.has(grid, 'onscrollend')) {
        grid.addEventListener('scrollend', recenterLoop);
      } else {
        let settleTimer = 0;
        let touching = false;

        function scheduleRecenter() {
          window.clearTimeout(settleTimer);
          if (!touching && loop) settleTimer = window.setTimeout(recenterLoop, 150);
        }

        grid.addEventListener('scroll', scheduleRecenter, { passive: true });
        grid.addEventListener('touchstart', () => {
          touching = true;
          scheduleRecenter();
        }, { passive: true });
        function finishTouch(event: TouchEvent) {
          touching = event.targetTouches.length > 0;
          scheduleRecenter();
        }
        grid.addEventListener('touchend', finishTouch, { passive: true });
        grid.addEventListener('touchcancel', finishTouch, { passive: true });
      }
      window.addEventListener('resize', invalidateGeometry);
      if ('ResizeObserver' in window) new ResizeObserver(invalidateGeometry).observe(grid);

      media.addEventListener('change', () => {
        geometry = undefined;
        if (media.matches) {
          scheduleUpdate();
          return;
        }

        clearFocus();
        loop?.before.forEach((tile) => tile.remove());
        loop?.after.forEach((tile) => tile.remove());
        loop = undefined;
      });

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            setGridVisible(entries.some((entry) => entry.isIntersecting));
          },
          { rootMargin: '120px 0px' },
        );

        observer.observe(grid);
      } else {
        // Old-browser fallback preserves the existing behavior.
        setGridVisible(true);
      }
    })();
  </script>

  <script>
    const fan = document.querySelector<HTMLElement>('[data-cycle-flux]');
    if (fan && 'IntersectionObserver' in window) {
      const grid = fan;
      const eligible = window.matchMedia(
        '(min-width: 861px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
      );
      let near = false;

      function loadFlux() {
        if (!near || !eligible.matches || document.hidden) return;
        approach.disconnect();
        eligible.removeEventListener('change', loadFlux);
        document.removeEventListener('visibilitychange', loadFlux);
        void import('../scripts/home-cycle-flux')
          .then(({ mountHomeCycleFlux }) => mountHomeCycleFlux(grid, eligible))
          .catch(() => { /* The decorative overlay is optional. */ });
      }

      const approach = new IntersectionObserver(([entry]) => {
        near = entry.isIntersecting;
        loadFlux();
      }, { rootMargin: '24px 0px' });
      approach.observe(grid);
      eligible.addEventListener('change', loadFlux);
      document.addEventListener('visibilitychange', loadFlux);
    }
  </script>

</BaseLayout>
