---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TagList from '../components/TagList.astro';
import ReadArrow from '../components/ReadArrow.astro';
import CycleName from '../components/CycleName.astro';
import InitialText from '../components/InitialText.astro';
import chronologyVisual from '../assets/page-visuals/chronology-records.jpg';
import { canLinkToPiece, cycleByName, cycleNamesForPiece, formatIsoDate, formatMonthYear, parseDate, pieces, publishedNewestFirst, site, upcomingPieces, publicationLabel } from '../lib/data';
import { withBase } from '../lib/paths';

const upcoming = upcomingPieces();
const published = publishedNewestFirst();
const chronologyWidths = [640, 768, 960, 1080, 1200, 1400];
const chronologySizes = '(max-width: 1687px) 64vw, 1080px';
// Share the transforms between both layouts and both flashlight layers.
const chronologySources = await Promise.all(
  (['avif', 'webp'] as const).map((format) => getImage({
    src: chronologyVisual,
    widths: chronologyWidths,
    width: 1400,
    format,
    quality: 55,
  })),
);
// CSS hiding and sizes="1px" still allow an eager image to download its
// smallest candidate. Let <source media> choose a photo only for its layout.
const emptyImage = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';

function dateTimestamp(date: string | null) {
  return parseDate(date)?.getTime() ?? 0;
}

function cycleLinksForPiece(piece: (typeof pieces)[number]) {
  return cycleNamesForPiece(piece)
    .map((name) => cycleByName.get(name))
    .filter((cycle): cycle is NonNullable<typeof cycle> => Boolean(cycle));
}
---

<BaseLayout title={`Publications & Bibliography — ${site.author}`} description="Alexei Raymond's short fiction, flash fiction and poetry in literary journals and anthologies, with publication dates and links to read online.">
  <div class="page-shell page-with-visual chronology-with-visual">
    <div class="page-copy">
      <section class="page-hero page-hero--index chronology-hero" aria-labelledby="chronology-title">
        <picture style="display: contents">
          {chronologySources.map((image) => (
            <source media="(max-width: 1080px)" type={`image/${image.options.format}`} srcset={image.srcSet.attribute} sizes="100vw" />
          ))}
          <img
            class="chronology-hero-backdrop"
            src={emptyImage}
            width={chronologyVisual.width}
            height={chronologyVisual.height}
            alt=""
            loading="eager"
            fetchpriority="high"
            decoding="async"
            aria-hidden="true"
          />
        </picture>
        <div class="chronology-hero-scrim" aria-hidden="true"></div>
        <h1 class="page-heading" id="chronology-title" data-title-shimmer>Chronology</h1>
        <p class="page-intro cycle-intro">A chronological bibliography of published and forthcoming work.</p>
      </section>

      {upcoming.length > 0 && (
        <section class="chronology-section chronology-upcoming" aria-labelledby="upcoming-title">
          <h2 id="upcoming-title">Upcoming</h2>
          <ul class="chronology-list">
            {upcoming.map((piece) => {
              const pieceCycles = cycleLinksForPiece(piece);
              const accountHref = piece.account ? withBase(`accounts/${piece.account.slug}/`) : undefined;
              const readLabel = 'Read';

              return (
                <li class="chronology-item">
                  <div class="chronology-title-row">
                    <h3 class="chronology-piece-title">
                      {accountHref ? (
                        <a href={accountHref}><InitialText text={piece.title} capitalInitials /></a>
                      ) : (
                        <InitialText text={piece.title} capitalInitials />
                      )}
                    </h3>
                    {accountHref && (
                      <a class="chronology-read-link" href={accountHref} aria-label={`${readLabel}: ${piece.title} on this site`}>
                        <span>{readLabel}</span> <ReadArrow />
                      </a>
                    )}
                  </div>
                  <p class="chronology-publication-line">
                    Forthcoming in <span class="pub">{publicationLabel(piece)}</span>
                    {piece.awardNote && (
                      <span class="chronology-award-note">
                        <span class="chronology-publication-separator" aria-hidden="true">&middot;</span>
                        <strong class="award-note">{piece.awardNote}</strong>
                      </span>
                    )}
                  </p>
                  <div class="chronology-meta">
                    <TagList tags={piece.tags.filter((tag) => tag !== 'Upcoming').map((tag) => tag === 'In print' ? 'Print' : tag)} />
                    <div class="chronology-cycle-links" aria-label={`${pieceCycles.length > 1 ? 'Cycles' : 'Cycle'} for ${piece.title}`}>
                      <span>{pieceCycles.length > 1 ? 'Cycles' : 'Cycle'}</span>
                      {pieceCycles.map((cycle, index) => (
                        <>
                          {index > 0 && <span aria-hidden="true">·</span>}
                          <a href={withBase(`cycles/${cycle.id}/`)}><CycleName name={cycle.name} /></a>
                        </>
                      ))}
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      <section class="chronology-section" aria-labelledby="published-title">
        <div class="chronology-heading-row">
          <h2 id="published-title">Published</h2>
          <div class="chronology-sort" aria-label="Sort published pieces">
            <button type="button" class="sort-button is-active" data-sort-order="newest" aria-label="Sort latest first" aria-pressed="true"><InitialText text="Latest" /></button>
            <button type="button" class="sort-button" data-sort-order="oldest" aria-label="Sort earliest first" aria-pressed="false"><InitialText text="Earliest" /></button>
            <button type="button" class="sort-button" data-sort-order="onsite" aria-label="Place works readable on this site first" aria-pressed="false"><InitialText text="Read here" /></button>
          </div>
        </div>

        <ul class="chronology-list" data-published-list>
          {published.map((piece, index) => {
            const year = parseDate(piece.date)?.getFullYear();
            const previousYear = index > 0 ? parseDate(published[index - 1].date)?.getFullYear() : null;
            const pieceCycles = cycleLinksForPiece(piece);
            const monthYear = formatMonthYear(piece.date);
            const accountHref = piece.account ? withBase(`accounts/${piece.account.slug}/`) : undefined;
            const readLabel = 'Read';

            return (
              <>
                {year && year !== previousYear && (
                  <li class="chron-year-sep" data-sort-separator aria-hidden="true">{year}</li>
                )}
                <li
                  class="chronology-item"
                  data-date={dateTimestamp(piece.date)}
                  data-on-site={piece.account?.slug ? 'true' : 'false'}
                >
                  <div class="chronology-title-row">
                    <h3 class="chronology-piece-title">
                      {canLinkToPiece(piece) ? (
                        <a href={piece.link} target="_blank" rel="noopener noreferrer" aria-label={`Read ${piece.title} at ${publicationLabel(piece)}. Opens in a new tab.`}><InitialText text={piece.title} capitalInitials /></a>
                      ) : accountHref ? (
                        <a href={accountHref}><InitialText text={piece.title} capitalInitials /></a>
                      ) : (
                        <InitialText text={piece.title} capitalInitials />
                      )}
                    </h3>
                    {accountHref && (
                      <a class="chronology-read-link" href={accountHref} aria-label={`${readLabel}: ${piece.title} on this site`}>
                        <span>{readLabel}</span> <ReadArrow />
                      </a>
                    )}
                  </div>
                  <p class="chronology-publication-line">
                    First published in <span class="pub">{publicationLabel(piece)}</span>
                    {monthYear && (
                      <>
                        <span class="chronology-publication-separator" aria-hidden="true">&middot;</span>
                        <time datetime={formatIsoDate(piece.date)}>{monthYear}</time>
                      </>
                    )}
                    {piece.awardNote && (
                      <span class="chronology-award-note">
                        <span class="chronology-publication-separator" aria-hidden="true">&middot;</span>
                        <strong class="award-note">{piece.awardNote}</strong>
                      </span>
                    )}
                  </p>
                  <div class="chronology-meta">
                    <TagList tags={piece.tags.map((tag) => tag === 'In print' ? 'Print' : tag)} />
                    <div class="chronology-cycle-links" aria-label={`${pieceCycles.length > 1 ? 'Cycles' : 'Cycle'} for ${piece.title}`}>
                      <span>{pieceCycles.length > 1 ? 'Cycles' : 'Cycle'}</span>
                      {pieceCycles.map((cycle, index) => (
                        <>
                          {index > 0 && <span aria-hidden="true">·</span>}
                          <a href={withBase(`cycles/${cycle.id}/`)}><CycleName name={cycle.name} /></a>
                        </>
                      ))}
                    </div>
                  </div>
                </li>
              </>
            );
          })}
        </ul>
      </section>
    </div>

    <aside class="page-visual chronology-visual" aria-hidden="true" data-chronology-visual>
      {['', 'chronology-color'].map((className) => (
        <picture style="display: contents">
          {chronologySources.map((image) => (
            <source media="(width > 1080px)" type={`image/${image.options.format}`} srcset={image.srcSet.attribute} sizes={chronologySizes} />
          ))}
          <img
            class={className || undefined}
            src={emptyImage}
            width={chronologyVisual.width}
            height={chronologyVisual.height}
            alt=""
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
        </picture>
      ))}
    </aside>
  </div>

  <script>
    const list = document.querySelector<HTMLElement>('[data-published-list]');
    const buttons = Array.from(document.querySelectorAll<HTMLElement>('[data-sort-order]'));
    let activeOrder = 'newest';

    function sortPublished(order: string) {
      if (!list || order === activeOrder) return;

      const onsiteFirst = order === 'onsite';
      const items = Array.from(list.querySelectorAll<HTMLElement>('.chronology-item'), (element) => ({
        element,
        time: Number(element.dataset.date || 0),
        onsite: element.dataset.onSite === 'true',
      }));

      items.sort((a, b) => {
        if (onsiteFirst && a.onsite !== b.onsite) return a.onsite ? -1 : 1;
        return order === 'oldest' ? a.time - b.time : b.time - a.time;
      });

      const rows = document.createDocumentFragment();
      let lastGroup: string | number | null = null;
      for (const { element, time, onsite } of items) {
        const group = onsiteFirst
          ? (onsite ? 'Available here' : 'Other publications')
          : (time ? new Date(time).getFullYear() : null);
        if (group && group !== lastGroup) {
          const separator = document.createElement('li');
          separator.className = onsiteFirst ? 'chron-year-sep chron-group-sep' : 'chron-year-sep';
          separator.dataset.sortSeparator = '';
          if (!onsiteFirst) separator.setAttribute('aria-hidden', 'true');
          separator.textContent = String(group);
          rows.appendChild(separator);
          lastGroup = group;
        }
        rows.appendChild(element);
      }
      list.replaceChildren(rows);
      activeOrder = order;

      for (const button of buttons) {
        const active = button.dataset.sortOrder === order;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      }
    }

    // The initial year separators are already rendered in the static HTML.

    for (const button of buttons) {
      button.addEventListener('click', () => {
        sortPublished(button.dataset.sortOrder || 'newest');
      });
    }
  </script>

  <script>
    import { setRevealPosition, trackColorReveal } from '../scripts/color-reveal';

    const visual = document.querySelector<HTMLElement>('[data-chronology-visual]');
    const container = document.querySelector<HTMLElement>('.chronology-with-visual');
    const layer = visual?.querySelector<HTMLElement>('.chronology-color');
    if (visual && container && layer) {
      trackColorReveal(visual, (x, y) => setRevealPosition(layer, x, y), {
        trigger: container,
        minWidth: 1081,
      });
    }
  </script>

  <style is:global>
    .chronology-hero + .chronology-section {
      margin-top: 0;
    }

    /* The records photograph rides the right margin on desktop; below
       1081px that side visual is hidden, so the same image becomes a
       Selected-style banner behind the page title instead. */
    .chronology-hero-backdrop,
    .chronology-hero-scrim {
      display: none;
    }

    @media (max-width: 1080px) {
      .chronology-hero {
        position: relative;
        margin-inline: calc(50% - 50vw);
        padding-inline: calc(50vw - 50%);
        overflow: hidden;
        isolation: isolate;
      }

      .chronology-hero-backdrop {
        display: block;
        position: absolute;
        inset: 0;
        z-index: 0;
        width: 100%;
        height: 100%;
        max-width: none;
        object-fit: cover;
        object-position: 54% 28%;
        opacity: 1;
        /* Colour, not mono: mobile headers show the photograph in colour
           (homepage hero, Selected banner on touch) — this one follows. */
        filter: brightness(0.72) contrast(1.02) saturate(1);
        -webkit-mask-image: none;
        mask-image: none;
      }

      .chronology-hero-scrim {
        display: block;
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient(
          180deg,
          rgba(10, 10, 10, 0.62) 0%,
          rgba(10, 10, 10, 0.3) 42%,
          rgba(10, 10, 10, 0.55) 78%,
          var(--bg) 100%
        );
        pointer-events: none;
      }

      .chronology-hero .page-heading,
      .chronology-hero .page-intro {
        position: relative;
        z-index: 2;
      }

      .chronology-hero .page-intro {
        text-shadow: 0 1px 3px #000, 0 2px 12px #000;
      }
    }
  </style>
</BaseLayout>
