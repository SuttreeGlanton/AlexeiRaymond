---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import InspirationHeartbeat from '../components/InspirationHeartbeat.astro';
import LocationHeartbeat from '../components/LocationHeartbeat.astro';
import LoveHeartbeat from '../components/LoveHeartbeat.astro';
import PlaylistGallery from '../components/PlaylistGallery.astro';
import aboutVisual from '../assets/page-visuals/about-portrait.jpg';
import { site, socialHref, socialLabel } from '../lib/data';
import { absoluteSiteUrl, withBase } from '../lib/paths';

const publicationsPhrase = 'a variety of publications';
// Bind the final two words without changing the authored biography.
const displayBio = site.bio.replace(/(\S+)\s+(\S+)$/, '$1\u00a0$2');
const [bioBefore, bioAfter] = displayBio.split(publicationsPhrase);
const canLinkPublications = typeof bioAfter === 'string';
const locations = site.bioLocations ?? [];
const openingLocation = locations[0];
const locationPhrase = openingLocation ? `in ${openingLocation.replace(/\.$/, '')}.` : '';
const [bioLead, bioTail] = locationPhrase ? bioBefore.split(locationPhrase) : [bioBefore];
// Give the opening its own line and reserve the tallest actual location variant.
const loves = site.bioLoves ?? [];
const loveLead = "He's been known to love ";
const [bioAfterPublications, loveList] = (bioAfter ?? '').split(loveLead);
const openingLoves = (loveList ?? '').replace(/\.$/, '').split(/,\s*(?:and\s+)?/);
const canRotateLoves = loves.length > openingLoves.length && openingLoves.every((item) => loves.includes(item));
const siteUrl = absoluteSiteUrl('', Astro.site);
const aboutUrl = absoluteSiteUrl('about/', Astro.site);
const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${aboutUrl}#profile`,
  name: `About ${site.author}`,
  url: aboutUrl,
  mainEntity: {
    '@type': 'Person',
    '@id': `${siteUrl}#person`,
    name: site.author,
    url: siteUrl,
    description: site.bio,
    jobTitle: 'Writer',
    sameAs: [
      ...site.socials.map(socialHref).filter(Boolean),
      'https://www.bloodhoneylit.com/alexei-raymond',
      'https://www.discretionarylove.com/author/alexeiraymond/'
    ]
  }
};
// Prefer a pre-encoded address so the plain email does not appear in this
// public repository. Fallback keeps the old plain-email path working.
const emailEncoded = site.emailEncoded || (site.email ? Buffer.from(site.email).toString('base64') : '');
---

<BaseLayout
  title={`About — ${site.author}`}
  description="About Alexei Raymond, his writing, editorial work, social profiles, and contact information."
  structuredData={profileSchema}
>
  <div class="page-shell page-with-visual about-with-visual">
    <section class="page-hero page-hero--index text-page page-copy about-copy" aria-labelledby="about-title">
      <h1 class="page-heading" id="about-title" data-title-shimmer>About</h1>
      <figure class="page-visual about-visual">
        <Image
          src={aboutVisual}
          alt={`Portrait of ${site.author}`}
          widths={[320, 480, 640, 768, 914]}
          sizes="(max-width: 728px) calc(100vw - 48px), (max-width: 1080px) 680px, (max-width: 1600px) 40vw, 640px"
          format="webp"
          quality={82}
          loading="eager"
          decoding="async"
        />
      </figure>
      <div class="prose biography">
        {typeof bioTail === 'string' && (
          <p class="bio-opening">
            <span>{bioLead}<LocationHeartbeat locations={locations} /></span>
            {locations.map((place) => <span class="bio-reserve" aria-hidden="true">{bioLead}<span class="bio-location-phrase">in&nbsp;{place.replace(/\.$/, '')}.</span></span>)}
          </p>
        )}
        <p class="bio-rest">
          {canLinkPublications ? (
            <>
              {typeof bioTail === 'string' ? bioTail.trimStart() : bioBefore}<a class="about-publications-link" href={withBase('chronology/')}>{publicationsPhrase}</a>{canRotateLoves ? <>{bioAfterPublications}<LoveHeartbeat items={loves} opening={openingLoves} lead={loveLead} /></> : bioAfter}
            </>
          ) : (
            displayBio
          )}
        </p>
      </div>

      {site.inspirations?.length && (
        <div class="about-inspiration">
          <InspirationHeartbeat names={site.inspirations} />
        </div>
      )}

    </section>
  </div>

  {site.playlists?.length && <PlaylistGallery playlists={site.playlists} />}

  <div class="page-shell about-connections">
      {site.socials.length > 0 && (
        <section class="social-block" aria-labelledby="socials-title">
          <h2 class="about-section-heading" id="socials-title">Socials</h2>
          <ul class="social-list about-social-icon-list" aria-label="Social links">
            {site.socials.map((social) => {
              const href = socialHref(social);
              const label = socialLabel(social);

              return href && (label === 'X' || label === 'Instagram') ? (
                <li>
                  <a
                    class="about-social-icon"
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${site.author} on ${label}. Opens in a new tab.`}
                    title={label}
                  >
                    {label === 'X' ? (
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z" />
                      </svg>
                    ) : (
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.7" />
                        <circle cx="12" cy="12" r="4.25" fill="none" stroke="currentColor" stroke-width="1.7" />
                        <circle cx="17.35" cy="6.65" r="1" />
                      </svg>
                    )}
                  </a>
                </li>
              ) : null;
            })}
          </ul>
        </section>
      )}

      {emailEncoded && (
        <section class="social-block" aria-labelledby="contact-title">
          <h2 class="about-section-heading" id="contact-title">Contact</h2>
          <p class="contact-line">
            <button type="button" class="contact-reveal" data-email={emailEncoded}>Show email address</button>
          </p>
        </section>
      )}
  </div>

  <script>
    /* Reveal the email only on interaction, decoded from base64 so it is
       never present as plain text in the page source. */
    const revealButton = document.querySelector<HTMLElement>('.contact-reveal');
    const encodedEmail = revealButton?.dataset.email;
    if (revealButton && encodedEmail) {
      revealButton.addEventListener('click', () => {
        const address = atob(encodedEmail);
        const link = document.createElement('a');
        link.href = 'mailto:' + address;
        link.textContent = address;
        link.className = 'contact-email';
        revealButton.replaceWith(link);
      }, { once: true });
    }
  </script>
</BaseLayout>

<style>
  .about-with-visual {
    min-height: 0;
    padding-bottom: 44px;
  }

  /* Keep the desktop portrait anchored to the outer shell after moving it
     beside the heading in reading order. */
  .about-with-visual .about-copy { position: static; }
  .about-copy > :is(.page-heading, .biography, .about-inspiration) {
    position: relative;
    z-index: 2;
  }
  .about-copy .biography { margin-top: var(--page-heading-gap); }

  .about-copy.page-hero {
    padding-bottom: 0;
    max-width: 680px;
  }

  .about-visual {
    top: 40px;
    bottom: 0;
    height: calc(100% - 40px);
  }

  .about-connections {
    display: grid;
    grid-template-columns: minmax(0, max-content) minmax(0, 1fr);
    gap: 24px clamp(28px, 7vw, 80px);
    padding: 12px 0 48px;
  }

  .about-connections .social-block { margin: 0; }
  .about-connections h2 { margin-bottom: 18px; }
  .about-connections :is(.social-list, .contact-line) { margin: 0; }
  .about-connections :global(.contact-email) { overflow-wrap: anywhere; }
  .about-copy .prose { text-wrap: pretty; }
  .biography > p { margin: 0; }
  .bio-opening { display: grid; }
  .bio-opening > span { grid-area: 1 / 1; min-width: 0; }
  .bio-location-phrase { white-space: nowrap; }
  .bio-reserve { visibility: hidden; pointer-events: none; user-select: none; }

  @media print, (prefers-reduced-motion: reduce) {
    .bio-reserve { display: none; }
  }

  @media (max-width: 1080px) {
    .about-with-visual,
    .about-connections {
      width: min(680px, calc(100% - 48px));
    }

    .about-with-visual { padding-bottom: 30px; }
    .about-copy.page-hero { padding-top: 30px; }

    .about-with-visual .about-visual {
      display: block;
      position: relative;
      inset: auto;
      z-index: auto;
      width: 100%;
      height: clamp(240px, 66.67vw, 340px);
      margin: 24px 0;
      border-radius: 10px;
      background: var(--panel);
    }

    .about-visual :global(img) {
      opacity: 1;
      object-position: 100% 5%;
      filter: grayscale(1) brightness(0.73) contrast(1.05);
      border-radius: inherit;
      clip-path: none;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .about-visual::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 65%, rgba(10, 10, 10, 0.6));
    }

    .about-copy .biography {
      margin-top: 0;
    }
    .biography .bio-opening { margin-bottom: 14px; }

    .about-inspiration {
      margin-top: 30px;
      padding-top: 25px;
      background: var(--banner-divider);
    }
    .about-inspiration :global(.inspiration-heartbeat) { margin-top: 0; }
    .about-inspiration :global(.about-section-heading) { margin-bottom: 15px; }

    .about-connections {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.55fr);
      gap: 22px;
      padding: 25px 0 30px;
      background: var(--banner-divider);
    }
    .about-connections h2 { margin-bottom: 12px; }
    .about-connections .social-block { min-width: 0; }
    .about-connections .contact-reveal {
      min-height: 44px;
      font-size: 0.85rem;
      text-align: left;
    }
    .about-connections :global(.contact-email) { font-size: 0.85rem; }
    .about-social-icon-list .about-social-icon { width: 36px; height: 44px; }
  }

  .prose .about-publications-link {
    border-bottom: 0;
  }

  .about-social-icon-list {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .about-social-icon-list li {
    display: flex;
  }

  .about-social-icon-list .about-social-icon {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--dim);
    transition: background 220ms ease, border-color 220ms ease, color 220ms ease;
  }

  .about-social-icon-list .about-social-icon:hover,
  .about-social-icon-list .about-social-icon:focus-visible {
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.025);
    color: var(--initial-accent);
  }

  .about-social-icon-list .about-social-icon svg {
    display: block;
    width: 17px;
    height: 17px;
    fill: currentColor;
  }
</style>
