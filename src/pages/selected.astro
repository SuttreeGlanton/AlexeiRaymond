---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PieceCard from '../components/PieceCard.astro';
import { featuredPieces, site } from '../lib/data';
import selectedHeader from '../assets/selected-header-trees.jpg';
import selectedHeaderMobile from '../assets/selected-header-trees-mobile.webp';

const selected = featuredPieces();
const selectedHeroWidths = [640, 768, 960, 1280, 1440, 1600, 1920, 2048];
const heroImageOptions = { widths: selectedHeroWidths, width: 2048, quality: 55 };
const [heroAvif, heroWebp, mobileAvif, mobileWebp] = await Promise.all([
  getImage({ src: selectedHeader, ...heroImageOptions, format: 'avif' }),
  getImage({ src: selectedHeader, ...heroImageOptions, format: 'webp' }),
  getImage({ src: selectedHeaderMobile, ...heroImageOptions, format: 'avif' }),
  getImage({ src: selectedHeaderMobile, ...heroImageOptions, format: 'webp' }),
]);
// The crop trims the vertical margins of the existing 46% mobile framing.
// Keep the full source for narrower layouts where the title can wrap.
const mobileHeroMedia = '(min-width: 360px) and (max-width: 640px)';
---

<BaseLayout title={`Selected Stories & Poems — ${site.author}`} description="Read a selection of short stories, flash fiction and poems by Alexei Raymond, with original publication credits and links to the full texts.">
  <section class="selected-hero" aria-labelledby="selected-title" data-color-reveal>
    {['selected-hero-backdrop--mono', 'selected-hero-color-reveal'].map((layer, index) => (
      <picture style="display: contents">
        <source media={mobileHeroMedia} type="image/avif" srcset={mobileAvif.srcSet.attribute} sizes="100vw" />
        <source media={mobileHeroMedia} type="image/webp" srcset={mobileWebp.srcSet.attribute} sizes="100vw" />
        <source type="image/avif" srcset={heroAvif.srcSet.attribute} sizes="100vw" />
        <img
          class={`selected-hero-backdrop ${layer}`}
          src={heroWebp.src}
          srcset={heroWebp.srcSet.attribute}
          sizes="100vw"
          width={selectedHeader.width}
          height={selectedHeader.height}
          alt=""
          loading="eager"
          decoding={index === 0 ? 'sync' : 'async'}
          fetchpriority={index === 0 ? 'high' : undefined}
          aria-hidden={index === 1 ? 'true' : undefined}
        />
      </picture>
    ))}
    <div class="selected-hero-scrim" aria-hidden="true"></div>

    <div class="page-shell selected-hero-content">
      <h1 class="page-heading" id="selected-title" data-title-shimmer>Selected Works</h1>
      <p class="page-intro cycle-intro">A selected variety from across the cycles.</p>
    </div>
  </section>

  <div class="page-shell">
    {selected.length > 0 ? (
      <section class="piece-grid selected-piece-grid" aria-label="Selected works">
        {selected.map((piece) => (
          <PieceCard
            piece={piece}
            showCycle={true}
            imageSizes="(max-width: 640px) 112px, (max-width: 860px) 45vw, 360px"
            titleLines={piece.titleLines}
            titleInitials
          />
        ))}
      </section>
    ) : (
      <p class="cycle-intro">Selections are being chosen.</p>
    )}
  </div>

  <script>
    import { setRevealPosition, trackColorReveal } from '../scripts/color-reveal';

    const hero = document.querySelector<HTMLElement>('.selected-hero[data-color-reveal]');
    const layer = hero?.querySelector<HTMLElement>('.selected-hero-color-reveal');
    if (hero && layer) {
      trackColorReveal(hero, (x, y, bounds) => setRevealPosition(layer, x, y, bounds));
    }
  </script>

  <style is:global>
    /* Selected Works has the homepage's photographic language in a shallower banner. */
    .selected-hero {
      --reveal-x: 50%;
      --reveal-y: 50%;
      position: relative;
      overflow: hidden;
      isolation: isolate;
    }

    .selected-hero-backdrop {
      position: absolute;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      max-width: none;
      object-fit: cover;
      object-position: 50% 42%;
    }

    .selected-hero-backdrop--mono {
      filter: grayscale(1) brightness(0.4) contrast(1.07);
    }

    .selected-hero-color-reveal {
      z-index: 0;
      opacity: 0;
      filter: brightness(1.02) contrast(1.04) saturate(1.12);
      transition: opacity 160ms ease;
      will-change: opacity, mask-image, -webkit-mask-image;
      pointer-events: none;

      -webkit-mask-image: radial-gradient(
        circle at var(--reveal-x) var(--reveal-y),
        rgba(0, 0, 0, 1) 0,
        rgba(0, 0, 0, 1) 120px,
        rgba(0, 0, 0, 0.78) 230px,
        rgba(0, 0, 0, 0.36) 340px,
        rgba(0, 0, 0, 0) 460px
      );
      mask-image: radial-gradient(
        circle at var(--reveal-x) var(--reveal-y),
        rgba(0, 0, 0, 1) 0,
        rgba(0, 0, 0, 1) 120px,
        rgba(0, 0, 0, 0.78) 230px,
        rgba(0, 0, 0, 0.36) 340px,
        rgba(0, 0, 0, 0) 460px
      );
    }

    .selected-hero.is-color-reveal-active .selected-hero-color-reveal {
      opacity: 1;
    }

    .selected-hero-scrim {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(
        180deg,
        rgba(10, 10, 10, 0.62) 0%,
        rgba(10, 10, 10, 0.3) 42%,
        rgba(10, 10, 10, 0.55) 78%,
        var(--bg) 100%
      );
      pointer-events: none;
    }

    .selected-hero-content {
      position: relative;
      z-index: 2;
      padding-top: var(--page-heading-offset);
      padding-bottom: var(--page-hero-tail);
      -webkit-user-select: none;
      user-select: none;
    }

    .selected-hero .page-heading {
      --title-shimmer-shadow: drop-shadow(0 2px 14px rgba(0, 0, 0, 0.56));
      text-shadow: var(--title-ink-shadow, 0 2px 28px rgba(0, 0, 0, 0.56));
    }

    .selected-hero .page-intro {
      position: relative;
      z-index: 4;
      max-width: 650px;
      color: var(--text);
      font-weight: 500;
      text-shadow:
        0 1px 2px rgba(0, 0, 0, 0.98),
        0 3px 16px rgba(0, 0, 0, 0.96),
        0 0 34px rgba(0, 0, 0, 0.88);
    }

    @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
      .selected-hero-backdrop--mono {
        filter: brightness(0.72) contrast(1.02) saturate(1);
      }

      .selected-hero-color-reveal {
        display: none;
      }
    }

    @media (max-width: 640px) {
      .selected-hero-backdrop {
        object-position: 50% 46%;
      }

      .selected-hero .page-intro {
        max-width: 30ch;
        font-size: 0.98rem;
      }
    }
  </style>
</BaseLayout>
