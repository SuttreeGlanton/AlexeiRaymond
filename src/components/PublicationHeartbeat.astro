---
import { uniqueVenues } from '../lib/publication-credits';

interface Props {
  names: string[];
  initial: string[];
}

const { names, initial } = Astro.props;
const pool = uniqueVenues(names);
const opening = uniqueVenues([...initial, ...pool]).slice(0, 2);
const sentence = (venues: string[]) => `Work published in ${venues.join(' and ')}, among others.`;
// Reserve space for long credits without giving short names oversized slots.
const longest = [...pool].sort((a, b) => b.length - a.length).slice(0, 2);
---

{opening.length > 0 && (
  <span class="publication-heartbeat" data-publication-heartbeat data-venues={JSON.stringify(pool)}>
    <span class="sr-only">{sentence(opening)}</span>
    {[
      { venues: opening, reserve: false },
      { venues: longest, reserve: true },
    ].map(({ venues, reserve }) => (
      <span class={reserve ? 'publication-heartbeat-reserve' : 'publication-heartbeat-copy'} aria-hidden="true">
        <span class="credit-wide">Work published in </span>
        <span class="credit-mobile credit-label">Published in</span>
        <i data-publication-name={reserve ? undefined : ''}>{venues[0]}</i>{venues[1] && (
          <><span class="credit-wide"> and </span><i data-publication-name={reserve ? undefined : ''}>{venues[1]}</i></>
        )}<span class="credit-wide">, among&nbsp;others.</span>
        <span class="credit-mobile credit-tail">among others</span>
      </span>
    ))}
  </span>
)}

<script>
  import '../scripts/publication-heartbeat';
</script>

<style>
  .publication-heartbeat {
    display: grid;
    overflow-wrap: anywhere;
  }

  .publication-heartbeat-copy,
  .publication-heartbeat-reserve {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .publication-heartbeat-reserve {
    visibility: hidden;
    pointer-events: none;
    user-select: none;
  }

  @media print, (prefers-reduced-motion: reduce) {
    .publication-heartbeat-reserve { display: none; }
  }
</style>
