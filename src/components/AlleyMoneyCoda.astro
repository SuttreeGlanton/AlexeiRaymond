---
import cacodemonSheet from '../assets/codas/cacodemon.png';
import { assetPath } from '../lib/paths';

interface Props {
  variant: 'desktop' | 'header';
}
const { variant } = Astro.props;
---

<span class={`am-coda am-coda--${variant}`} data-am-coda={variant} data-sprite-sheet={cacodemonSheet.src}>
  <span class="am-traveler" data-am-traveler>
    <button
      class="am-cacodemon"
      type="button"
      aria-label="Defeat the Cacodemon"
      data-am-cacodemon
    >
      <canvas width="112" height="112" aria-hidden="true" data-am-cacodemon-canvas></canvas>
    </button>
  </span>
</span>
{variant === 'desktop' && <audio src={assetPath('audio/doom.mp3')} preload="auto" data-am-cacodemon-audio></audio>}
{variant === 'desktop' && <span class="sr-only" aria-live="polite" data-am-cacodemon-status></span>}

<script>
  import '../scripts/alley-money-coda';
</script>

<style>
  :global(.archived-piece-page--alley-money .archive-prose > p),
  :global(.archived-piece-page--alley-money .archive-prose > p + p) {
    text-indent: 0;
  }

  :global(.archived-piece-page--alley-money .archive-prose > p.am-indent) {
    text-indent: 1.6em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .am-coda {
    display: none;
    position: relative;
    margin: 0;
    line-height: 1;
    text-indent: 0;
    pointer-events: none;
  }

  .am-traveler {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 112px;
    height: 112px;
  }

  .am-cacodemon {
    display: block;
    pointer-events: auto;
    width: 112px;
    height: 112px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: crosshair;
    --am-bob: 8px;
    animation: am-cacodemon-hover 1.6s steps(8, end) infinite;
    touch-action: manipulation;
  }

  .am-cacodemon[aria-disabled="true"] {
    cursor: default;
  }

  .am-cacodemon[aria-busy='true'] {
    animation-play-state: paused;
  }

  .am-cacodemon:focus-visible {
    outline: 1px solid var(--text-soft);
    outline-offset: 5px;
  }

  .am-cacodemon canvas {
    display: block;
    width: 112px;
    height: 112px;
    image-rendering: pixelated;
  }

  @keyframes am-cacodemon-hover {
    0%, 100% { transform: translateY(calc(-1 * var(--am-bob))); }
    50% { transform: translateY(var(--am-bob)); }
  }

  @media (min-width: 861px) {
    .am-coda--desktop[data-am-ready] {
      display: block;
      height: clamp(112px, calc(100svh - 510px), 300px);
      margin-top: 12px;
    }
  }

  @media (max-width: 860px) {
    .am-coda--header[data-am-ready] {
      display: block;
      width: min(228px, calc(100vw - 132px));
      height: 44px;
    }
    .am-coda--header .am-traveler,
    .am-coda--header .am-cacodemon,
    .am-coda--header canvas {
      width: 64px;
      height: 64px;
    }
    .am-coda--header .am-traveler { top: -10px; }
    .am-coda--header .am-cacodemon { --am-bob: 4px; }
    :global(.site-header:not(.header-coda-on)) .am-cacodemon {
      pointer-events: none;
      animation-play-state: paused;
    }
  }

  @media (min-width: 641px) and (max-width: 860px) {
    .am-coda--header[data-am-ready] { width: 150px; }
  }

  .am-coda[data-am-paused] .am-cacodemon { animation-play-state: paused; }

  @media (prefers-reduced-motion: reduce) {
    .am-cacodemon {
      animation: none;
    }
  }

  @media print {
    .am-coda--desktop[data-am-ready],
    .am-coda--header[data-am-ready] { display: none; }
  }
</style>

<style is:global>
  @media (min-width: 861px) {
    .archived-piece-page--alley-money .archive-body-shell.has-archive-cover .alley-money-cover-slot {
      display: block;
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: 96px;
      align-self: start;
      width: 100%;
    }
    .archived-piece-page--alley-money .archive-body-shell.has-archive-cover .alley-money-cover-slot .archive-cover-card {
      position: static;
      margin: 0;
      width: 100%;
    }
  }

  /* A short desktop viewport still needs room to aim below the cover. */
  @media (min-width: 861px) and (max-height: 640px) {
    .archived-piece-page--alley-money .alley-money-cover-slot .archive-cover-media {
      aspect-ratio: auto;
      height: max(80px, calc(100svh - 240px));
    }
  }

  @media (max-width: 860px) {
    .site-header[data-header-coda-type="cacodemon"] { position: sticky; top: 0; }
    .site-header[data-header-coda-type="cacodemon"] .header-inner { position: relative; }
    .site-header[data-header-coda-type="cacodemon"] .header-coda-slot {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      display: flex;
      align-items: center;
      pointer-events: none;
    }
    .site-header[data-header-coda-type="cacodemon"].header-coda-on .brand {
      opacity: 0;
      visibility: hidden;
    }
  }

</style>
