---
import { assetPath } from '../lib/paths';
interface Props { src: string; title: string; slug: string; excerpt?: string; }
const { src, title, slug, excerpt } = Astro.props;
const clip = Boolean(excerpt);
const seekId = `reading-seek-${slug}`;
const source = assetPath(src);
---

<div class:list={['reading-audio', { 'card-overlay reading-clip': clip, 'reading-full': !clip }]} data-reading-audio data-reading-title={title} data-reading-kind={clip ? 'excerpt' : 'full'}>
  <a data-reading-fallback class:list={['reading-fallback', { 'card-excerpt': clip }]} href={source}>
    {clip ? <>&ldquo;{excerpt}&rdquo;</> : <>Listen to &ldquo;{title}&rdquo;</>}
  </a>
  <div class="reading-controls" data-reading-controls hidden>
    <button type="button" class:list={['reading-toggle', { 'hero-sound-toggle': !clip }]} data-reading-toggle aria-label={`Play ${clip ? 'excerpt from' : 'reading of'} ${title}`} aria-describedby={clip ? `reading-quote-${slug}` : undefined}>
      {clip && <span id={`reading-quote-${slug}`} class="card-excerpt reading-quote">&ldquo;{excerpt}&rdquo;</span>}
      <span class="reading-cue">
        <svg class="reading-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z" /></svg>
        <svg class="reading-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M6 5h4v14H6zm8 0h4v14h-4z" /></svg>
        {clip && <span data-reading-label>Listen</span>}
      </span>
    </button>
    {!clip && <div class="reading-track">
      <label for={seekId} data-reading-label>Listen</label>
      <input id={seekId} data-reading-seek type="range" min="0" max="1" step="any" value="0" aria-label={`Position in reading of ${title}`} disabled />
    </div>}
  </div>
  <span class="reading-status" data-reading-status role="status" hidden></span>
  <audio data-reading-media data-src={source} preload="none"></audio>
</div>

<style>
  .reading-audio [hidden] { display: none; }
  .reading-audio audio { display: none; }
  .reading-full { max-width: 570px; margin-top: 24px; }
  .reading-controls { display: flex; align-items: center; gap: 17px; width: 100%; }
  .reading-full .reading-toggle { position: static; inset: auto; z-index: auto; flex: 0 0 44px; }
  .reading-toggle { -webkit-tap-highlight-color: transparent; }
  .reading-cue { display: inline-flex; align-items: center; gap: 6px; }
  .reading-cue svg { flex: none; }
  .reading-pause { display: none; }
  [data-state='playing'] .reading-play, [data-state='loading'] .reading-play { display: none; }
  [data-state='playing'] .reading-pause, [data-state='loading'] .reading-pause { display: block; }
  .reading-track { flex: 1; min-width: 0; }
  .reading-track label, .reading-full .reading-fallback { color: var(--text-soft); font-family: var(--serif); font-size: 1rem; }
  .reading-track label { display: block; line-height: 1.5; }
  .reading-track input { --reading-progress: 0%; display: block; width: 100%; height: 28px; margin: 0; padding: 0; appearance: none; -webkit-appearance: none; background: transparent; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .reading-track input:disabled { cursor: default; opacity: 0.45; }
  .reading-track input::-webkit-slider-runnable-track { height: 2px; border: 0; border-radius: 2px; background: linear-gradient(to right, var(--initial-accent) var(--reading-progress), var(--border-strong) var(--reading-progress)); }
  .reading-track input::-moz-range-track { height: 2px; border: 0; border-radius: 2px; background: var(--border-strong); }
  .reading-track input::-moz-range-progress { height: 2px; background: var(--initial-accent); }
  .reading-track input::-webkit-slider-thumb { appearance: none; -webkit-appearance: none; width: 8px; height: 8px; border: 0; border-radius: 50%; margin-top: -3px; background: var(--text-soft); }
  .reading-track input::-moz-range-thumb { width: 8px; height: 8px; border: 0; border-radius: 50%; background: var(--text-soft); }
  .reading-track input:is(:hover, :focus-visible)::-webkit-slider-thumb { background: var(--initial-accent); }
  .reading-track input:is(:hover, :focus-visible)::-moz-range-thumb { background: var(--initial-accent); }
  .reading-status { color: var(--text-soft); font-size: 0.8rem; }
  .reading-full .reading-status { display: block; margin: 8px 0 0 61px; }
  .reading-full .reading-status[hidden] { display: none; }
  .reading-clip { flex-direction: column; justify-content: end; align-items: stretch; }
  .reading-clip .reading-toggle { display: block; width: 100%; min-height: 44px; padding: 0; border: 0; background: transparent; text-align: left; color: var(--text-soft); cursor: pointer; }
  .reading-clip .reading-quote { display: block; }
  .reading-clip .reading-cue { margin-top: 10px; font: 0.75rem/1.5 var(--sans); letter-spacing: 0.04em; }
  .reading-clip .reading-cue svg { width: 13px; height: 13px; }
  .reading-clip .reading-toggle:is(:hover, :focus-visible), .reading-clip[data-state='playing'] .reading-cue { color: var(--initial-accent); }
  .reading-clip .reading-status { margin-top: 8px; }
  @keyframes reading-quote-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.76; } }
  @media (prefers-reduced-motion: no-preference) {
    :global(.archive-cover-card.is-mobile-focus) .reading-clip[data-state='idle']:not([data-document-hidden]) .reading-quote { animation: reading-quote-pulse 3.6s ease-in-out infinite; }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global(.archive-cover-card:is(:hover, :focus-within)) .reading-clip[data-state='idle']:not([data-document-hidden]) .reading-quote { animation: reading-quote-pulse 3.6s ease-in-out infinite; }
  }
  @media (pointer: coarse) { .reading-track input { height: 44px; } }
  @media (forced-colors: active) { .reading-track input { appearance: auto; -webkit-appearance: auto; } }
  @media print { .reading-full, .reading-clip { display: none; } }
</style>
