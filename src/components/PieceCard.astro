---
import { cycleLabel as labelForCycle } from '../lib/data-rules.mjs';
import TagList from './TagList.astro';
import ReadArrow from './ReadArrow.astro';
import CycleIcon from './CycleIcon.astro';
import InitialText from './InitialText.astro';
import OptimizedImage from './OptimizedImage.astro';
import type { Piece } from '../lib/data';
import { canLinkToPiece, cycleByName, formatShortDate, isDefunct, isUpcoming, parseDate, publicationLabel } from '../lib/data';
import { assetPath, withBase } from '../lib/paths';
import { CARD_IMAGE_WIDTHS, imageAsset } from '../lib/image-assets';

interface Props {
  piece: Piece;
  variant?: 'selected';
  storyOrder?: number;
  sourceOrder?: number;
  priority?: boolean;
  imageSizes?: string;
  imageWidths?: number[];
  titleLines?: string[];
  titleInitials?: boolean;
}

const {
  piece,
  variant,
  storyOrder,
  sourceOrder,
  priority = false,
  imageSizes = '(max-width: 640px) 69vw, (max-width: 860px) 45vw, 360px',
  imageWidths = CARD_IMAGE_WIDTHS,
  titleLines,
  titleInitials = false
} = Astro.props;
const upcoming = isUpcoming(piece);
const defunct = isDefunct(piece);
const linked = canLinkToPiece(piece);
const cover = piece.cover ? assetPath(piece.cover) : '';
const coverImage = imageAsset(piece.cover);
const mobileAvifQuality = [
  'covers/pieces/glassdom.jpg',
  'covers/pieces/last-sight-of-her.jpg',
  'covers/pieces/nazi.jpg',
].includes(piece.cover ?? '') ? 54 : undefined;
const accountHref = piece.account ? withBase(`accounts/${piece.account.slug}/`) : '';
const accountLabel = 'Read here';
const hasBothDestinations = Boolean(accountHref) && linked;
const primaryHref = accountHref || (linked ? piece.link : '');
const primaryExternal = !accountHref && linked;
const primaryLinkProps = primaryExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const primaryLabel = primaryExternal
  ? `Read ${piece.title} at ${publicationLabel(piece)}. Opens in a new tab.`
  : `${accountLabel}: ${piece.title} on this site`;
const displayTitleLines = titleLines ?? [piece.title];
const longTitle = piece.title.length >= 18;
const cycleTitleFit = piece.title === '193 Thoughts of You';
const className = `piece-card${upcoming ? ' is-upcoming' : ''}${defunct ? ' is-defunct' : ''}${longTitle ? ' has-long-title' : ''}${cycleTitleFit ? ' has-cycle-title-fit' : ''}`;

const selected = variant === 'selected';
const cycleLabel = selected ? labelForCycle(piece.cycle) : '';
const cycle = selected ? cycleByName.get(piece.cycle) : undefined;
// Keep the abbreviated publication date on the cover's attached label.
const dateLabel = upcoming ? 'SOON' : formatShortDate(piece.date);
const publicationDate = parseDate(piece.date);
const publicationTime = publicationDate?.getTime() ?? 0;
const publicationYear = publicationDate?.getFullYear();
const storyOrderLabel = storyOrder ? String(storyOrder).padStart(2, '0') : '';

const imageLoading = priority ? 'eager' : 'lazy';
const imageFetchPriority = priority ? 'high' : undefined;
const coverLinkLabel = [
  `${piece.title} cover`,
  dateLabel,
  primaryLabel
].filter(Boolean).join(' ');
const metaParts = [
  cycleLabel ? { text: cycleLabel, className: cycle ? 'card-cycle-label' : undefined } : null,
  piece.publication ? { text: publicationLabel(piece), className: 'card-publication' } : null
].filter((part) => part !== null);
---

<article
  class:list={[className, { 'has-card-rim': selected || piece.awardNote, 'has-award-rim': piece.awardNote }]}
  data-piece-card
  data-story-order={storyOrder}
  data-source-order={sourceOrder}
  data-publication-time={publicationTime}
  data-upcoming={upcoming ? 'true' : 'false'}
>
  {primaryHref && !hasBothDestinations ? (
    <a class="card-cover-link" href={primaryHref} {...primaryLinkProps} tabindex="-1" aria-label={coverLinkLabel}>
      <div class="date-cover" data-publication-year={publicationYear}>
        <div class="card-media">
          {cover ? (
            <OptimizedImage path={piece.cover} image={coverImage} alt={`${piece.title} cover`} loading={imageLoading} fetchpriority={imageFetchPriority} sizes={imageSizes} widths={imageWidths} mobileAvifQuality={mobileAvifQuality} />
          ) : (
            <div class="placeholder" aria-hidden="true"><span>{piece.title}</span></div>
          )}
          {piece.excerpt && (
            <div class="card-overlay" aria-hidden="true">
              <p class="card-excerpt">&ldquo;{piece.excerpt}&rdquo;</p>
            </div>
          )}
        </div>
        {dateLabel && <span class="date-mark" data-publication-year={publicationYear}>{dateLabel}</span>}
      </div>
    </a>
  ) : (
    <div class="date-cover" data-publication-year={publicationYear}>
      <div class="card-media">
        {cover ? (
          <OptimizedImage path={piece.cover} image={coverImage} alt={`${piece.title} cover`} loading={imageLoading} fetchpriority={imageFetchPriority} sizes={imageSizes} widths={imageWidths} mobileAvifQuality={mobileAvifQuality} />
        ) : (
          <div class="placeholder" aria-hidden="true"><span>{piece.title}</span></div>
        )}
        {piece.excerpt && (
          <div class="card-overlay" aria-hidden="true">
            <p class="card-excerpt">&ldquo;{piece.excerpt}&rdquo;</p>
          </div>
        )}
      </div>
      {dateLabel && <span class="date-mark" data-publication-year={publicationYear}>{dateLabel}</span>}
    </div>
  )}
  {cycle && (
    <span class="card-cycle-glyph" role="img" aria-label={cycleLabel}>
      <CycleIcon id={cycle.id} />
    </span>
  )}
  <div class="card-body">
    {storyOrderLabel && <span class="story-order-mark">{storyOrderLabel}</span>}
    <h2 class="card-title">
      {primaryHref && !hasBothDestinations ? (
        <a href={primaryHref} {...primaryLinkProps} aria-label={primaryLabel}>
          {displayTitleLines.map((line, index) => (
            <>{index > 0 && <br />}{titleInitials ? <InitialText text={line} capitalInitials /> : line}</>
          ))}
        </a>
      ) : (
        displayTitleLines.map((line, index) => (
          <>{index > 0 && <br />}{titleInitials ? <InitialText text={line} capitalInitials /> : line}</>
        ))
      )}
    </h2>
    {(metaParts.length > 0 || piece.awardNote) && (
      <div class="card-meta">
        {metaParts.map((part, index) => (
          <>
            {index > 0 && <span class="meta-separator" aria-hidden="true">&middot;</span>}
            <span class={part.className}>{part.text}</span>
          </>
        ))}
        {piece.awardNote && <strong class="award-note card-award-note">{piece.awardNote}</strong>}
      </div>
    )}
    {piece.excerpt && <p class="card-mobile-excerpt">&ldquo;{piece.excerpt}&rdquo;</p>}
    {piece.note && <p class="card-note">{piece.note}</p>}
    <TagList tags={piece.tags.filter((tag) => tag !== 'Online' && tag !== 'In print' && tag !== 'Upcoming')} />
  </div>
  {(piece.account || linked) && (
    <div class:list={['account-strip', 'card-reading-links', { 'has-two-destinations': hasBothDestinations }]}>
      {piece.account && (
        <a class="card-read-here" href={accountHref} aria-label={`${accountLabel}: ${piece.title} on this site`}>
          <span>{accountLabel}</span> <ReadArrow />
        </a>
      )}
      {linked && (
        <a class="card-read-original" href={piece.link} target="_blank" rel="noopener noreferrer" aria-label={`Original publication: ${piece.title} at ${publicationLabel(piece)}. Opens in a new tab.`}>
          <span>Original publication</span> <ReadArrow external />
        </a>
      )}
    </div>
  )}
  {(selected || piece.awardNote) && <span class="card-rim" aria-hidden="true"></span>}
</article>
