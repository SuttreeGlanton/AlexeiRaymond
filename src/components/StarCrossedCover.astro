---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import OptimizedImage from './OptimizedImage.astro';
import { CARD_IMAGE_QUALITY, CARD_IMAGE_WIDTHS } from '../lib/image-assets';
import controllerUrl from '../scripts/star-crossed-cover.js?url';

interface Props { alt: string; }
const { alt } = Astro.props;
const sizes = '(max-width: 640px) 76vw, (max-width: 860px) 42vw, 280px';
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/covers/pieces/star-crossed_*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const covers = [3, 4, 5, 6, 1, 2].map(number => {
  const matches = Object.entries(modules).filter(([path]) =>
    new RegExp(`/star-crossed_${number}\\.(jpg|jpeg|png|webp|avif)$`).test(path)
  );
  if (matches.length !== 1) {
    throw new Error(`Star-Crossed needs exactly one star-crossed_${number} image in src/assets/covers/pieces.`);
  }
  return { number, image: matches[0][1].default };
});
const sources = await Promise.all(covers.map(async ({ number, image }) => {
  const images = await Promise.all(CARD_IMAGE_WIDTHS.map(width => getImage({
    src: image, width, format: 'webp', quality: CARD_IMAGE_QUALITY, fit: 'cover', position: 'center'
  })));
  const largest = images[images.length - 1];
  return {
    number,
    src: largest.src,
    srcset: images.map((image, index) => `${image.src} ${CARD_IMAGE_WIDTHS[index]}w`).join(', '),
    sizes,
    width: Number(largest.attributes.width),
    height: Number(largest.attributes.height)
  };
}));
---

<div class="sc-cover-stack" data-sc-cover data-sc-cover-number="3" role="img" aria-label={alt}>
  <div class="sc-cover-frame is-current" data-sc-cover-frame aria-hidden="true">
    <OptimizedImage image={covers[0].image} alt="" loading="eager" fetchpriority="high" sizes={sizes} />
  </div>
  <div class="sc-cover-frame" data-sc-cover-frame aria-hidden="true"></div>
  <script is:inline type="application/json" data-sc-cover-sources set:html={JSON.stringify(sources).replace(/</g, '\\u003c')} />
</div>
<script is:inline type="module" src={controllerUrl}></script>

<style is:global>
  [data-sc-story] .sc-cover-stack,
  [data-sc-story] .sc-cover-frame {
    position: absolute;
    inset: 0;
  }
  [data-sc-story] .sc-cover-frame {
    opacity: 0;
    z-index: 0;
    transition: opacity 700ms ease;
    pointer-events: none;
  }
  [data-sc-story] .sc-cover-frame.is-current { opacity: 1; z-index: 1; }
  [data-sc-story] .sc-cover-frame.is-entering { opacity: 1; z-index: 2; }
  [data-sc-story] .archive-cover-card .archive-cover-media .sc-cover-stack img {
    filter: none;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-sc-story] .sc-cover-frame { transition: none; }
  }
</style>
