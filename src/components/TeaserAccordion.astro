---
import { pieces, canLinkToPiece, cycleByName } from '../lib/data';
import { withBase } from '../lib/paths';

const keepLastTwoWordsTogether = (text: string) =>
  text.trim().replace(/\s+(\S+)$/u, '\u00a0$1');

const teasers = pieces
  .filter((piece) => Boolean(piece.excerpt?.trim()))
  .map((piece) => {
    const cycle = cycleByName.get(piece.cycle);
    const external = !piece.account && canLinkToPiece(piece);
    return {
      excerpt: keepLastTwoWordsTogether(piece.excerpt!),
      title: piece.title,
      href: piece.account
        ? withBase(`accounts/${piece.account.slug}/`)
        : external
          ? piece.link
          : withBase(cycle ? `cycles/${cycle.id}/` : 'chronology/'),
      external,
    };
  });

const firstTeaser = teasers[0];
---

{firstTeaser && (
  <div
    class="teaser-accordion"
    data-teaser-accordion
    data-teasers={JSON.stringify(teasers)}
    role="group"
    aria-label="Excerpts from the work"
  >
    <p class="teaser-accordion-line" aria-live="off">
      <span class="teaser-accordion-anchor" aria-hidden="true">“</span><span class="teaser-accordion-fold" data-teaser-fold>
        <span class="teaser-accordion-copy" data-teaser-copy>{firstTeaser.excerpt}”</span>
      </span>
    </p>
    <p class="teaser-accordion-source">
      <a
        data-teaser-source
        href={firstTeaser.href}
        aria-label={firstTeaser.external ? `${firstTeaser.title} (opens in a new tab)` : undefined}
        {...(firstTeaser.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >{firstTeaser.title}</a>
    </p>
  </div>
)}

<script>
  (() => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const HOLD_MS = 5000;
    const FOLD_MS = 480;

    document.querySelectorAll<HTMLElement>('[data-teaser-accordion]').forEach((root) => {
      const fold = root.querySelector<HTMLElement>('[data-teaser-fold]');
      const copy = root.querySelector<HTMLElement>('[data-teaser-copy]');
      const source = root.querySelector<HTMLAnchorElement>('[data-teaser-source]');
      const rawTeasers = root.dataset.teasers;

      if (!fold || !copy || !source || !rawTeasers) return;

      type Teaser = { excerpt: string; title: string; href: string; external: boolean };
      let teasers: Teaser[] = [];

      try {
        teasers = JSON.parse(rawTeasers);
      } catch {
        return;
      }

      if (!teasers.length) return;

      let index = 0;
      let timer = 0;
      function shuffleTeasers(items: Teaser[]) {
        for (let currentIndex = items.length - 1; currentIndex > 0; currentIndex -= 1) {
          const randomIndex = Math.floor(Math.random() * (currentIndex + 1));
          [items[currentIndex], items[randomIndex]] = [items[randomIndex], items[currentIndex]];
        }
      }

      function measureFold() {
        if (!copy || !fold) return;
        fold.style.setProperty('--teaser-width', `${Math.ceil(copy.getBoundingClientRect().width)}px`);
      }

      function showTeaser(nextIndex: number) {
        if (!copy || !source) return;
        const teaser = teasers[nextIndex];
        copy.textContent = `${teaser.excerpt}”`;
        source.textContent = teaser.title;
        source.href = teaser.href;
        if (teaser.external) {
          source.target = '_blank';
          source.rel = 'noopener noreferrer';
          source.setAttribute('aria-label', `${teaser.title} (opens in a new tab)`);
        } else {
          source.removeAttribute('target');
          source.removeAttribute('rel');
          source.removeAttribute('aria-label');
        }
        measureFold();
      }

      function advanceToNextTeaser() {
        if (index < teasers.length - 1) {
          index += 1;
          return;
        }

        const previousTeaser = teasers[index];
        shuffleTeasers(teasers);

        if (teasers[0] === previousTeaser) {
          [teasers[0], teasers[1]] = [teasers[1], teasers[0]];
        }

        index = 0;
      }

      shuffleTeasers(teasers);
      showTeaser(index);

      const shouldPause = () =>
        document.hidden || reducedMotion.matches || root.matches(':hover, :focus-within');

      function scheduleFold() {
        window.clearTimeout(timer);
        if (teasers.length < 2 || shouldPause()) return;
        timer = window.setTimeout(foldToNext, HOLD_MS);
      }

      function foldToNext() {
        if (shouldPause()) return;
        root.classList.add('is-folded');

        timer = window.setTimeout(() => {
          advanceToNextTeaser();
          showTeaser(index);

          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              root.classList.remove('is-folded');
              scheduleFold();
            });
          });
        }, FOLD_MS);
      }

      function pause() {
        window.clearTimeout(timer);
        root.classList.remove('is-folded');
      }

      function resume() {
        scheduleFold();
      }

      root.addEventListener('pointerenter', pause);
      root.addEventListener('pointerleave', resume);
      root.addEventListener('focusin', pause);
      root.addEventListener('focusout', () => requestAnimationFrame(resume));

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) pause();
        else if (!root.matches(':hover') && !root.matches(':focus-within')) resume();
      });

      reducedMotion.addEventListener('change', (event) => {
        if (event.matches) pause();
        else resume();
      });

      measureFold();
      document.fonts?.ready.then(measureFold);
      window.addEventListener('resize', measureFold, { passive: true });
      scheduleFold();
    });
  })();
</script>

<style>
  .teaser-accordion {
    container-type: inline-size;
    --teaser-limit: calc(100cqw - 0.6em);
    width: 100%;
    min-height: 10.5rem;
    max-width: 26rem;
    border-top: 1px solid rgba(200, 197, 190, 0.3);
    padding-top: 1rem;
    color: var(--text-soft);
    outline-offset: 6px;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.85);
    text-align: left;
  }

  .teaser-accordion-line {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    min-height: 0;
    margin: 0;
    color: var(--text-soft);
    font-family: var(--serif);
    font-size: clamp(1.12rem, 1.4vw, 1.25rem);
    font-style: italic;
    line-height: 1.45;
    text-align: left;
  }

  .teaser-accordion-anchor {
    flex: 0 0 auto;
    margin-right: -0.04em;
  }

  .teaser-accordion-fold {
    display: inline-block;
    min-width: 0;
    max-width: var(--teaser-width, var(--teaser-limit));
    overflow: hidden;
    opacity: 1;
    white-space: nowrap;
    text-align: left;
    vertical-align: top;
    transition:
      max-width 460ms cubic-bezier(0.25, 0.8, 0.25, 1),
      opacity 260ms ease;
  }

  .teaser-accordion-copy {
    display: block;
    width: max-content;
    max-width: var(--teaser-limit);
    white-space: normal;
    text-wrap: pretty;
    text-align: left;
  }

  .teaser-accordion-source {
    margin: 0.55rem 0 0;
    color: var(--text-soft);
    font-family: var(--sans);
    font-size: 0.81rem;
    letter-spacing: 0.01em;
    opacity: 1;
    text-align: left;
    transition: opacity 220ms ease;
  }

  .teaser-accordion-source a {
    display: inline-block;
    padding: 6px 0;
    text-decoration: underline;
    text-decoration-color: var(--muted);
    text-underline-offset: 5px;
  }

  .teaser-accordion-source a:hover,
  .teaser-accordion-source a:focus-visible {
    color: var(--text);
    text-decoration-color: currentColor;
  }

  .teaser-accordion.is-folded .teaser-accordion-fold {
    max-width: 0;
    opacity: 0;
  }

  .teaser-accordion.is-folded .teaser-accordion-source {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .teaser-accordion-fold,
    .teaser-accordion-source {
      transition: none;
    }
  }
</style>
