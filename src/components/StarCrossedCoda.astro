---
import variants from '../data/star-crossed-variants.json';
import controllerUrl from '../scripts/star-crossed-coda.js?url';
---

<span class="sc-sr-only" id="sc-help">Activate this passage to change its wording or colour.</span>
<span class="sc-sr-only" data-sc-status role="status" aria-live="polite" aria-atomic="true"></span>

<script is:inline type="application/json" data-sc-variants set:html={JSON.stringify(variants).replace(/</g, '\\u003c')} />
<script is:inline type="module" src={controllerUrl}></script>

<style is:global>
  [data-sc-story] .archive-prose {
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }
  /* Labels wrap naturally across lines. Each contains a real native button,
     so pointer, touch, Enter and Space all reach the same accessible action. */
  [data-sc-story] .sc-fragment {
    position: relative;
    display: inline;
    text-indent: 0;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  [data-sc-story] .sc-ink {
    color: #fff4df;
    border-radius: 2px;
    text-shadow: 0 0 0.38em rgb(248 221 166 / 0.48);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: opacity 200ms ease, color 900ms ease, text-shadow 240ms ease, background-color 240ms ease;
  }
  [data-sc-story] .sc-fragment:hover .sc-ink {
    text-shadow: 0 0 0.55em rgb(235 216 177 / 0.55);
  }
  [data-sc-story] [data-sc-mode="click"]:hover .sc-ink {
    background-color: rgb(235 216 177 / 0.045);
  }
  [data-sc-story] .sc-fragment:has(.sc-trigger:focus-visible) .sc-ink {
    outline: 1px solid var(--focus);
    outline-offset: 3px;
  }
  [data-sc-story] [data-sc-mode="click"] .sc-ink {
    padding: 0.015em 0.1em;
    border: 1px dashed rgb(234 230 217 / 0.3);
    border-radius: 0.18em;
    text-shadow: 0 0 0.32em rgb(248 221 166 / 0.24);
    transition: border-color 800ms ease-out, text-shadow 240ms ease, background-color 240ms ease;
  }
  [data-sc-story] [data-sc-mode="click"].is-clicked .sc-ink {
    border-color: rgb(255 255 255 / 0.95);
    transition-duration: 70ms, 240ms, 240ms;
  }
  /* A shallow fade softens changes to the descriptive words. */
  [data-sc-story] .sc-fragment.is-changing .sc-ink { opacity: 0.84; }
  [data-sc-story] .sc-color .sc-ink {
    display: inline-grid;
    vertical-align: baseline;
    color: var(--sc-color, #fff4df);
    text-shadow: 0 0 0.36em color-mix(in srgb, currentColor 52%, transparent);
  }
  [data-sc-story] .sc-color:hover .sc-ink {
    text-shadow: 0 0 0.48em color-mix(in srgb, currentColor 75%, transparent);
  }
  [data-sc-story] .sc-choice,
  [data-sc-story] .sc-measure {
    grid-area: 1 / 1;
    white-space: nowrap;
  }
  [data-sc-story] .sc-measure { visibility: hidden; pointer-events: none; }
  .sc-sr-only,
  [data-sc-story] .sc-trigger {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }
  [data-sc-story] .sc-trigger { top: 0; left: 0; }
  @media (prefers-reduced-motion: reduce) {
    [data-sc-story] .sc-ink { transition: none; }
  }
  @media (forced-colors: active) {
    [data-sc-story] .sc-ink {
      text-decoration: underline dotted;
      text-underline-offset: 0.2em;
      text-shadow: none;
    }
  }
  @media print {
    [data-sc-story] .sc-color .sc-ink { display: inline; }
    [data-sc-story] .sc-measure { display: none; }
    [data-sc-story] .sc-ink {
      color: inherit;
      text-shadow: none;
      outline: none;
      background: none;
      transition: none;
    }
    [data-sc-story] [data-sc-mode="click"] .sc-ink { border: 0; padding: 0; }
  }
</style>
