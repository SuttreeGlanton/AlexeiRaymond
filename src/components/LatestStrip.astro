---
import {
  publishedPieces,
  upcomingPieces,
  parseDate,
  formatMonthYear,
  publicationLabel,
  canLinkToPiece,
} from '../lib/data';
import { withBase } from '../lib/paths';
import { selectPublicationCredits } from '../lib/publication-credits';
import PublicationHeartbeat from './PublicationHeartbeat.astro';
import InitialText from './InitialText.astro';

const published = publishedPieces();
const latest = published
  .filter((piece) => parseDate(piece.date))
  .sort((a, b) => (parseDate(b.date)?.getTime() ?? 0) - (parseDate(a.date)?.getTime() ?? 0))[0];

/* Upcoming work with a known future date takes precedence. Once no dated
   release remains, choose one of the remaining Upcoming pieces at random. */
const KNOWN_RELEASE_DATES = new Map<string, string>([
  ['The Iron Crown', '10/08/2026'],
  ['Glassdom', '11/08/2026'],
  ['Speaking Terms', '18/08/2026'],
]);

const upcoming = upcomingPieces();
const credits = selectPublicationCredits(
  published.map((piece) => piece.publication),
  upcoming.map((piece) => piece.publication),
);
const pairedCredits = credits.published.length > 0 && credits.upcoming.length > 0;
const forthcomingCreditParts = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' })
  .formatToParts(credits.upcoming);
const today = new Date();
today.setHours(0, 0, 0, 0);

const datedForthcoming = upcoming
  .map((piece) => ({
    piece,
    releaseDate: parseDate(KNOWN_RELEASE_DATES.get(piece.title) ?? null),
  }))
  .filter(
    ({ releaseDate }) =>
      Boolean(releaseDate) && releaseDate!.getTime() >= today.getTime(),
  )
  .sort(
    (a, b) =>
      a.releaseDate!.getTime() - b.releaseDate!.getTime(),
  )[0]?.piece;

const randomForthcoming = upcoming.length
  ? upcoming[Math.floor(Math.random() * upcoming.length)]
  : undefined;

const forthcoming = datedForthcoming ?? randomForthcoming;

const latestHref = latest?.account
  ? withBase(`accounts/${latest.account.slug}/`)
  : latest && canLinkToPiece(latest)
    ? latest.link
    : '';
const latestExternal = Boolean(latestHref) && !latest?.account;
---

{latest && (
  <section class="page-shell latest-strip" aria-label="Latest and forthcoming work">
    <div class="latest-strip-band">
      <div class="latest-strip-head">
        <h2>Publications</h2>
        <a class="latest-strip-chronology" href={withBase('chronology/')}><span><InitialText text="Chronology" /></span> <span class="home-link-arrow" aria-hidden="true">→</span></a>
      </div>
      <p class:list={['latest-strip-credit', { 'latest-strip-credit--paired': pairedCredits }]}>
        <PublicationHeartbeat names={published.map((piece) => piece.publication)} initial={credits.published.slice(0, 2)} />
        {credits.upcoming.length > 0 && (
          <span class="latest-strip-credit-line">
            <span class="credit-wide">Forthcoming in </span>
            <span class="credit-mobile credit-label">Coming in</span>
            {forthcomingCreditParts.map((part) => (
              part.type === 'element' ? <i>{part.value}</i> : <span class="credit-wide">{part.value}</span>
            ))}<span class="credit-wide">.</span>
          </span>
        )}
      </p>
      <div class="latest-strip-row">
        <p class="latest-strip-item">
          <span class="latest-strip-overline">Latest</span>
          {latestHref ? (
            <a
              class="latest-strip-title"
              href={latestHref}
              {...(latestExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            ><span><InitialText text={latest.title} /></span> <span class="home-link-arrow" aria-hidden="true">→</span></a>
          ) : (
            <span class="latest-strip-title">{latest.title}</span>
          )}
          <span class="latest-strip-meta"><i>{publicationLabel(latest)}</i>{formatMonthYear(latest.date) ? `, ${formatMonthYear(latest.date)}` : ''}</span>
        </p>
        {forthcoming && (
          <p class="latest-strip-item">
            <span class="latest-strip-overline">Soon</span>
            <span class="latest-strip-title">{forthcoming.title}</span>
            <span class="latest-strip-meta"><i>{publicationLabel(forthcoming)}</i></span>
          </p>
        )}
        <p class="latest-strip-item latest-strip-item--chronology">
          <a class="latest-strip-chronology" href={withBase('chronology/')}><span><InitialText text="Chronology" /></span> <span class="home-link-arrow" aria-hidden="true">→</span></a>
        </p>
      </div>
    </div>
  </section>
)}

<style>
  /* On mobile the divider sits below the latest and forthcoming entries. */
  .latest-strip-band {
    display: flex;
    flex-direction: column;
    background: var(--banner-divider);
    padding: 1.5rem 0;
    margin: 0 0 0.75rem;
  }

  /* The desktop heading has its own chronology link. */
  .latest-strip-head {
    display: none;
  }

  .latest-strip-row {
    order: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 1.5rem 3rem;
    align-items: start;
  }

  .latest-strip-item {
    display: grid;
    justify-items: start;
    gap: 0.35rem;
    min-width: 0;
    margin: 0;
    font-family: var(--sans);
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    color: var(--text-soft);
  }

  .latest-strip-overline,
  .latest-strip-credit :global(.credit-label) {
    text-transform: uppercase;
    font-size: 0.69rem;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 0.15rem;
  }

  .latest-strip-title {
    font-family: var(--serif);
    font-size: 1.55rem;
    line-height: 1.25;
    letter-spacing: 0.01em;
    color: var(--text);
    text-decoration: none;
  }

  .latest-strip-title,
  .latest-strip-title > span:first-child {
    text-wrap: balance;
  }

  a.latest-strip-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
  }

  .latest-strip-chronology {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    font-size: 0.81rem;
    color: var(--text-soft);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .latest-strip-chronology:hover,
  .latest-strip-chronology:focus-visible {
    color: var(--text);
  }

  .latest-strip-credit {
    order: 2;
    margin: 1.35rem 0 0;
    font-family: var(--sans);
    font-size: 0.78rem;
    letter-spacing: 0.01em;
    color: var(--muted);
    text-wrap: pretty;
  }

  .latest-strip-credit-line {
    display: block;
  }

  .latest-strip-credit :global(.credit-mobile) {
    display: none;
  }

  .latest-strip-item--chronology {
    align-self: center;
  }

  @media (max-width: 860px) {
    .latest-strip-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem 2rem;
    }

    .latest-strip-item--chronology {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .latest-strip-band {
      background: none;
      padding: 1rem 0 2.5rem;
      margin-bottom: 0;
    }

    .latest-strip-row {
      display: contents;
    }

    .latest-strip-item {
      order: 1;
    }

    .latest-strip-item + .latest-strip-item {
      margin-top: 1.75rem;
    }

    .latest-strip-item.latest-strip-item--chronology {
      order: 3;
      align-self: flex-start;
      margin-top: 0.75rem;
    }

    .latest-strip-chronology {
      font-family: var(--serif);
    }

    .latest-strip-credit {
      margin-top: 1.5rem;
      padding-top: 1rem;
      background: var(--banner-divider);
    }

    .latest-strip-credit :global(.publication-heartbeat) {
      overflow-wrap: normal;
    }

    .latest-strip-credit :global(.credit-wide),
    .latest-strip-credit :global(.publication-heartbeat-reserve) {
      display: none;
    }

    .latest-strip-credit :global(.credit-mobile) {
      display: block;
    }

    .latest-strip-credit :global(.credit-label) {
      margin-bottom: 0.35rem;
    }

    .latest-strip-credit :global(i) {
      display: block;
      color: var(--text-soft);
      font: italic 1rem/1.4 var(--serif);
      letter-spacing: 0;
      white-space: nowrap;
    }

    .latest-strip-credit :global(.credit-tail) {
      margin-top: 0.2rem;
    }

    .latest-strip-credit-line {
      margin-top: 1rem;
    }
  }

  @media (min-width: 350px) and (max-width: 640px) {
    .latest-strip-credit--paired {
      display: grid;
      grid-template-columns: minmax(0, 16fr) minmax(0, 9fr);
      gap: 0.875rem;
      align-items: start;
    }

    .latest-strip-credit--paired .latest-strip-credit-line {
      margin-top: 0;
    }

    .latest-strip-credit--paired :global(i) {
      font-size: 0.9375rem;
      white-space: normal;
    }
  }

  @media screen and (min-width: 350px) and (max-width: 640px) and (prefers-reduced-motion: no-preference) {
    .latest-strip-credit--paired :global(.publication-heartbeat-reserve) {
      display: block;
    }
  }
</style>
