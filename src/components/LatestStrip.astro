---
import {
  publishedPieces,
  upcomingPieces,
  parseDate,
  formatMonthYear,
  publicationLabel,
  canLinkToPiece,
} from '../lib/data';
import { withBase } from '../lib/paths';
import { selectPublicationCredits } from '../lib/publication-credits';
import PublicationHeartbeat from './PublicationHeartbeat.astro';

const published = publishedPieces();
const latest = published
  .filter((piece) => parseDate(piece.date))
  .sort((a, b) => (parseDate(b.date)?.getTime() ?? 0) - (parseDate(a.date)?.getTime() ?? 0))[0];

/* Upcoming work with a known future date takes precedence. Once no dated
   release remains, choose one of the remaining Upcoming pieces at random. */
const KNOWN_RELEASE_DATES = new Map<string, string>([
  ['The Iron Crown', '10/08/2026'],
  ['Glassdom', '11/08/2026'],
  ['Speaking Terms', '18/08/2026'],
]);

const upcoming = upcomingPieces();
const credits = selectPublicationCredits(
  published.map((piece) => piece.publication),
  upcoming.map((piece) => piece.publication),
);
const forthcomingCreditParts = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' })
  .formatToParts(credits.upcoming);
const today = new Date();
today.setHours(0, 0, 0, 0);

const datedForthcoming = upcoming
  .map((piece) => ({
    piece,
    releaseDate: parseDate(KNOWN_RELEASE_DATES.get(piece.title) ?? null),
  }))
  .filter(
    ({ releaseDate }) =>
      Boolean(releaseDate) && releaseDate!.getTime() >= today.getTime(),
  )
  .sort(
    (a, b) =>
      a.releaseDate!.getTime() - b.releaseDate!.getTime(),
  )[0]?.piece;

const randomForthcoming = upcoming.length
  ? upcoming[Math.floor(Math.random() * upcoming.length)]
  : undefined;

const forthcoming = datedForthcoming ?? randomForthcoming;

const latestHref = latest?.account
  ? withBase(`accounts/${latest.account.slug}/`)
  : latest && canLinkToPiece(latest)
    ? latest.link
    : '';
const latestExternal = Boolean(latestHref) && !latest?.account;
---

{latest && (
  <section class="page-shell latest-strip" aria-label="Latest and forthcoming work">
    <div class="latest-strip-band">
      <div class="latest-strip-head">
        <h2>Publications</h2>
        <a class="latest-strip-chronology" href={withBase('chronology/')}>Full chronology &rarr;</a>
      </div>
      <p class="latest-strip-credit">
        <PublicationHeartbeat names={published.map((piece) => piece.publication)} initial={credits.published.slice(0, 2)} />
        {credits.upcoming.length > 0 && (
          <span class="latest-strip-credit-line">
            Forthcoming in {forthcomingCreditParts.map((part) => part.type === 'element' ? <i>{part.value}</i> : part.value)}.
          </span>
        )}
      </p>
      <div class="latest-strip-row">
        <p class="latest-strip-item">
          <span class="latest-strip-overline">Latest</span>
          {latestHref ? (
            <a
              class="latest-strip-title"
              href={latestHref}
              {...(latestExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >{latest.title}</a>
          ) : (
            <span class="latest-strip-title">{latest.title}</span>
          )}
          <span class="latest-strip-meta"><i>{publicationLabel(latest)}</i>{formatMonthYear(latest.date) ? `, ${formatMonthYear(latest.date)}` : ''}</span>
        </p>
        {forthcoming && (
          <p class="latest-strip-item">
            <span class="latest-strip-overline">Forthcoming</span>
            <span class="latest-strip-title latest-strip-title--static">{forthcoming.title}</span>
            <span class="latest-strip-meta"><i>{publicationLabel(forthcoming)}</i></span>
          </p>
        )}
        <p class="latest-strip-item latest-strip-item--chronology">
          <a class="latest-strip-chronology" href={withBase('chronology/')}>Full chronology &rarr;</a>
        </p>
      </div>
    </div>
  </section>
)}

<style>
  /* Desktop uses a rule; mobile separates sections with space. */
  .latest-strip-band {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
    margin: 0 0 0.75rem;
  }

  /* The desktop heading has its own chronology link. Only one link is visible
     at each breakpoint; the mobile link retains its existing reading order. */
  .latest-strip-head {
    display: none;
  }

  .latest-strip-row {
    order: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 1.5rem 3rem;
    align-items: start;
  }

  .latest-strip-item {
    display: grid;
    justify-items: start;
    gap: 0.35rem;
    min-width: 0;
    margin: 0;
    font-family: var(--sans);
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    color: var(--text-soft);
  }

  .latest-strip-overline {
    text-transform: uppercase;
    font-size: 0.69rem;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 0.15rem;
  }

  .latest-strip-title {
    font-family: var(--serif);
    font-size: 1.55rem;
    line-height: 1.25;
    letter-spacing: 0.01em;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--border-strong);
    transition: border-color 200ms ease;
  }

  .latest-strip-title--static {
    border-bottom: none;
  }

  a.latest-strip-title:hover,
  a.latest-strip-title:focus-visible {
    border-color: var(--text);
  }

  .latest-strip-chronology {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.81rem;
    color: var(--text-soft);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .latest-strip-chronology:hover,
  .latest-strip-chronology:focus-visible {
    color: var(--text);
  }

  .latest-strip-credit {
    order: 2;
    margin: 1.35rem 0 0;
    font-family: var(--sans);
    font-size: 0.78rem;
    letter-spacing: 0.01em;
    color: var(--muted);
  }

  .latest-strip-credit-line {
    display: block;
  }

  .latest-strip-item--chronology {
    align-self: center;
  }

  @media (max-width: 860px) {
    .latest-strip-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem 2rem;
    }

    .latest-strip-item--chronology {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .latest-strip-band {
      border-top: 0;
      padding: 1rem 0 2.5rem;
      margin-bottom: 0;
    }

    .latest-strip-row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.75rem;
    }

    .latest-strip-title {
      border-bottom: 0;
    }

    a.latest-strip-title {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 44px;
    }

    a.latest-strip-title::after {
      content: '→' / '';
      flex-shrink: 0;
      color: var(--text-soft);
      font-family: var(--sans);
      font-size: 0.875rem;
    }

    a.latest-strip-title[target='_blank']::after {
      content: '↗' / '';
    }
  }
</style>
