---
import {
  publishedPieces,
  upcomingPieces,
  parseDate,
  formatIsoDate,
  publicationLabel,
  canLinkToPiece,
  cycleByName,
} from '../lib/data';
import { selectLatestPublished, selectUpcoming } from '../lib/data-rules.mjs';
import { withBase } from '../lib/paths';
import { imageAsset } from '../lib/image-assets';
import { selectPublicationCredits } from '../lib/publication-credits';
import PublicationHeartbeat from './PublicationHeartbeat.astro';
import InitialText from './InitialText.astro';
import OptimizedImage from './OptimizedImage.astro';
import CycleIcon from './CycleIcon.astro';

const published = publishedPieces();
const latest = selectLatestPublished(published);

const upcoming = upcomingPieces();
const credits = selectPublicationCredits(
  published.map((piece) => piece.publication),
  upcoming.map((piece) => piece.publication),
);
const pairedCredits = credits.published.length > 0 && credits.upcoming.length > 0;
const forthcomingCreditParts = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' })
  .formatToParts(credits.upcoming);
// Choose from the authoritative Upcoming records at build time.
const forthcoming = selectUpcoming(upcoming);

const latestHref = latest?.account
  ? withBase(`accounts/${latest.account.slug}/`)
  : latest && canLinkToPiece(latest)
    ? latest.link
    : '';
const latestExternal = Boolean(latestHref) && !latest?.account;
const latestCover = imageAsset(latest?.cover);
const latestCycle = latest ? cycleByName.get(latest.cycle) : undefined;
const latestPublicationYear = latest ? parseDate(latest.date)?.getFullYear() : undefined;
const latestDateLabel = latest && parseDate(latest.date)?.toLocaleDateString('en-GB', {
  month: 'short',
  year: 'numeric',
});
---

{latest && (
  <section class="page-shell latest-strip" aria-labelledby="home-publications">
    <div class="latest-strip-band">
      <h2 class="latest-strip-heading" id="home-publications">Publications</h2>
      <article class:list={['latest-release-card', 'has-card-rim', { 'has-cover': latest.cover }]}>
        {latest.cover && (
          <div class="latest-release-cover date-cover" data-publication-year={latestPublicationYear} data-cover={latest.cover}>
            <div class="latest-release-media">
              <OptimizedImage
                path={latest.cover}
                image={latestCover}
                alt=""
                sizes="(max-width: 640px) calc(100vw - 42px), 212px"
                mobileAvifQuality={45}
              />
              {latest.excerpt && (
                <div class="latest-release-cover-quote" aria-hidden="true">
                  <p>&ldquo;{latest.excerpt}&rdquo;</p>
                </div>
              )}
            </div>
            {latestCycle && (
              <span class="latest-release-glyph" role="img" aria-label={`${latestCycle.name} cycle`}>
                <CycleIcon id={latestCycle.id} />
              </span>
            )}
            {latestDateLabel && (
              <time class="date-mark latest-release-date" data-publication-year={latestPublicationYear} datetime={formatIsoDate(latest.date)}>{latestDateLabel}</time>
            )}
          </div>
        )}
        <div class="latest-release-body">
          <p class="latest-strip-overline">Latest</p>
          <h3 class="latest-release-title"><InitialText text={latest.title} capitalInitials /></h3>
          <p class="latest-release-meta">
            {publicationLabel(latest)}
            {!latest.cover && latestDateLabel && <> · <time datetime={formatIsoDate(latest.date)}>{latestDateLabel}</time></>}
          </p>
          {latest.excerpt && <p class="latest-release-excerpt">&ldquo;{latest.excerpt}&rdquo;</p>}
          {latestHref && (
            <a
              class="latest-release-read"
              href={latestHref}
              aria-label={latestExternal ? `Visit publication: ${latest.title} at ${publicationLabel(latest)} (opens in a new tab)` : `Read ${latest.title} here`}
              {...(latestExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {latestExternal ? 'Visit publication' : 'Read here'} <span class="home-link-arrow" aria-hidden="true">{latestExternal ? '↗' : '→'}</span>
            </a>
          )}
        </div>
        <span class="card-rim" aria-hidden="true"></span>
      </article>
      <a class="latest-strip-chronology" href={withBase('chronology/')}>
        <span><InitialText text="Chronology" /></span> <span class="home-link-arrow" aria-hidden="true">→</span>
      </a>
      <div class="latest-strip-notes">
        {forthcoming && (
          <p class="latest-strip-forthcoming">
            <span class="latest-strip-overline">Soon</span>
            <span class="latest-strip-title">{forthcoming.title}</span>
            <span>{publicationLabel(forthcoming)}</span>
          </p>
        )}
        <p class:list={['latest-strip-credit', { 'latest-strip-credit--paired': pairedCredits }]}>
          <PublicationHeartbeat names={published.map((piece) => piece.publication)} initial={credits.published.slice(0, 2)} />
          {credits.upcoming.length > 0 && (
            <span class="latest-strip-credit-line">
              <span class="credit-wide">Forthcoming in </span>
              <span class="credit-mobile credit-label">Coming in</span>
              {forthcomingCreditParts.map((part) => (
                part.type === 'element' ? <i>{part.value}</i> : <span class="credit-wide">{part.value}</span>
              ))}<span class="credit-wide">.</span>
            </span>
          )}
        </p>
      </div>
    </div>
  </section>
)}

<script>
  const card = document.querySelector('.latest-release-card');

  if (card && 'IntersectionObserver' in window) {
    const mobile = window.matchMedia('(max-width: 640px)');
    let observer: IntersectionObserver | undefined;

    const syncFocus = () => {
      observer?.disconnect();
      observer = undefined;

      if (!mobile.matches) {
        card.classList.remove('is-mobile-focus');
        return;
      }

      // A narrow band tracks the viewport center without a scroll handler.
      const inset = Math.max(0, Math.floor(document.documentElement.clientHeight / 2) - 1);
      observer = new IntersectionObserver(([entry], activeObserver) => {
        if (activeObserver === observer) {
          card.classList.toggle('is-mobile-focus', entry.isIntersecting);
        }
      }, { rootMargin: `-${inset}px 0px` });
      observer.observe(card);
    };

    window.addEventListener('resize', syncFocus);
    syncFocus();
  }
</script>

<style>
  .latest-release-cover-quote {
    display: none;
  }

  @media (max-width: 640px) {
    .latest-release-cover-quote {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: end;
      padding: 16px;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.10), rgba(0, 0, 0, 0.86));
      opacity: 0;
      pointer-events: none;
      transition: opacity 320ms ease;
    }

    .latest-release-cover-quote p {
      margin: 0;
      color: var(--text-soft);
      font: italic 0.98rem/1.35 var(--serif);
      text-wrap: pretty;
      white-space: pre-line;
    }

    .latest-release-card:is(.is-mobile-focus, :focus-within) .latest-release-cover-quote {
      opacity: 1;
    }

    .latest-release-card.has-cover .latest-release-excerpt {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }

  .latest-strip-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'release release' 'soon chronology' 'credits credits';
    gap: 1.4rem 1rem;
    padding: 0.5rem 0 2.5rem;
  }

  .latest-strip-notes {
    display: contents;
  }

  .latest-strip-heading {
    grid-area: heading;
    margin: 0;
    font: 400 var(--home-section)/1.15 var(--serif);
  }

  .latest-release-card {
    position: relative;
    grid-area: release;
    display: grid;
    min-width: 0;
    overflow: visible;
    border: 1px solid var(--border-strong);
    border-radius: 7px;
    background: var(--panel);
    box-shadow: 0 10px 24px -14px rgb(0 0 0 / 0.8);
    transition: border-color 240ms ease, box-shadow 240ms ease;
  }

  .latest-release-card:is(.is-mobile-focus, :has(.latest-release-read:is(:hover, :focus-visible))) {
    --card-rim-display: block;
    border-color: color-mix(in srgb, var(--initial-accent) 38%, var(--border-strong));
    box-shadow: 0 12px 24px -16px color-mix(in srgb, var(--initial-accent) 42%, transparent);

    & .latest-release-media :global(img) {
      filter: brightness(0.98);
    }

    & .latest-release-title :global(.text-initial),
    & .latest-release-glyph {
      color: var(--initial-accent);
    }

    & .latest-release-glyph {
      filter: drop-shadow(0 0 0.8px #000) drop-shadow(0 1px 1.2px rgb(0 0 0 / 80%));
    }

    & .date-cover {
      --date-label: var(--date-accent);
    }

    & .latest-release-date {
      color: #0a0a0a;
    }
  }

  .latest-release-cover {
    aspect-ratio: 5 / 3;
  }

  .latest-release-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 6px 6px 0 0;
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .latest-release-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 73%;
    filter: saturate(0.86) brightness(0.88);
    transition: filter 280ms ease, transform 280ms ease;
  }

  .latest-release-date {
    white-space: nowrap;
    text-transform: uppercase;
  }

  .latest-release-glyph {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    display: grid;
    color: #000;
    pointer-events: none;
  }

  .latest-release-glyph :global(.cycle-icon) {
    width: 30px;
    height: 30px;
    margin: 0;
  }

  .latest-release-glyph :global(svg) {
    stroke-width: 2;
  }

  .latest-release-body {
    min-width: 0;
    padding: 1.15rem 1.2rem 1.3rem;
    font-family: var(--serif);
  }

  .latest-strip-overline,
  .latest-strip-credit :global(.credit-label) {
    margin: 0;
    color: var(--muted);
    font: 400 0.69rem/1.4 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .latest-release-title {
    margin: 0.55rem 0 0;
    color: var(--text);
    font: 400 clamp(2.05rem, 10vw, 2.5rem)/1.06 var(--serif);
    overflow-wrap: anywhere;
  }

  .latest-release-title :global(.text-initial) {
    transition: color 240ms ease;
  }

  .latest-release-meta {
    margin: 0.3rem 0 0;
    color: var(--text-soft);
    font-size: 0.96rem;
    line-height: 1.35;
  }

  .latest-release-excerpt {
    max-width: 55ch;
    margin: 0.95rem 0 0;
    color: var(--text-soft);
    font: italic 1.12rem/1.3 var(--serif);
    text-wrap: balance;
  }

  .latest-release-read,
  .latest-strip-chronology {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    width: fit-content;
  }

  .latest-release-read {
    margin-top: 0.95rem;
    color: var(--text);
    font-size: 1.12rem;
    line-height: 1.2;
    -webkit-tap-highlight-color: transparent;
  }

  /* The reading link covers the card while its heading and excerpt stay separate. */
  .latest-release-read::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  .latest-release-card:has(.latest-release-read:focus-visible) {
    outline: 1px solid var(--focus);
    outline-offset: 5px;
  }

  .latest-release-read:focus-visible {
    outline: none;
  }

  .latest-strip-forthcoming {
    grid-area: soon;
    display: grid;
    gap: 0.22rem;
    min-width: 0;
    margin: 0;
    color: var(--text-soft);
    font: 400 0.94rem/1.35 var(--serif);
  }

  .latest-strip-title {
    margin-top: 0.22rem;
    color: var(--text);
    font-size: clamp(1.32rem, 4.8vw, 1.75rem);
    line-height: 1.15;
    text-wrap: balance;
  }

  .latest-strip-chronology {
    grid-area: chronology;
    align-self: center;
    justify-self: end;
    min-height: 44px;
    color: var(--text-soft);
    font: 400 0.94rem/1.4 var(--serif);
    transition: color 200ms ease;
  }

  .latest-strip-chronology:is(:hover, :focus-visible) {
    color: var(--text);
  }

  .latest-strip-credit {
    grid-area: credits;
    margin: 0;
    padding-top: 1rem;
    background: var(--banner-divider);
    color: var(--muted);
    font: 400 0.94rem/1.45 var(--serif);
  }

  .latest-strip-credit-line {
    display: block;
    margin-top: 1rem;
  }

  .latest-strip-credit :global(.credit-mobile) {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .latest-release-card:has(.latest-release-read:is(:hover, :focus-visible)) .latest-release-media :global(img) {
      transform: scale(1.018);
    }
  }

  @media (max-width: 860px) {
    .latest-strip-heading {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (max-width: 640px) {
    .latest-release-cover[data-cover='covers/pieces/zagagulyn.jpg'] .latest-release-media :global(img) {
      object-position: center 50%;
    }
  }

  @media (min-width: 641px) {
    .latest-release-card.has-cover {
      grid-template-columns: clamp(186px, 26%, 212px) minmax(0, 1fr);
      min-height: 17.8rem;
    }

    .latest-release-cover {
      aspect-ratio: auto;
    }

    .latest-release-media {
      border-radius: 6px 0 0 6px;
      border-right: 1px solid var(--border);
      border-bottom: 0;
    }

    .latest-release-media :global(img) {
      object-position: center;
      filter: saturate(0.75) brightness(0.86);
    }

    .latest-release-body {
      align-self: center;
      padding: 1.7rem clamp(1.35rem, 2.5vw, 2.15rem);
    }

    .latest-release-title {
      font-size: clamp(2.5rem, 3.75vw, 3.2rem);
    }

    .latest-release-meta {
      font-size: 1.03rem;
    }

    .latest-release-excerpt {
      margin-top: 1.35rem;
      font-size: 1.3rem;
    }

    .latest-release-read {
      margin-top: 1.25rem;
      font-size: 1.22rem;
    }
  }

  @media (min-width: 861px) {
    .latest-strip-band {
      grid-template-columns: minmax(0, 2.7fr) minmax(0, 1fr);
      grid-template-areas: 'heading chronology' 'release notes';
      column-gap: clamp(1.5rem, 3.8vw, 3.25rem);
      row-gap: 1.05rem;
      padding: 1.75rem 0 0;
      background: var(--banner-divider);
    }

    .latest-strip-notes {
      grid-area: notes;
      display: flex;
      flex-direction: column;
      gap: 1.55rem;
      padding-top: 1rem;
    }

    .latest-strip-forthcoming {
      font-size: var(--home-detail);
    }

    .latest-strip-forthcoming .latest-strip-overline {
      font: 400 var(--home-detail)/1.4 var(--serif);
      letter-spacing: 0;
      text-transform: none;
    }

    .latest-strip-chronology {
      font-size: var(--home-link);
    }

    .latest-strip-credit {
      padding-top: 0;
      background: none;
      font-size: var(--home-detail);
    }
  }

  @media (max-width: 640px) {
    .latest-release-card.is-mobile-focus .home-link-arrow {
      color: var(--initial-accent);
    }

    .latest-strip-credit :global(.publication-heartbeat) {
      overflow-wrap: normal;
    }

    .latest-strip-credit :global(.credit-wide),
    .latest-strip-credit :global(.publication-heartbeat-reserve) {
      display: none;
    }

    .latest-strip-credit :global(.credit-mobile) {
      display: block;
    }

    .latest-strip-credit :global(.credit-label) {
      margin-bottom: 0.35rem;
    }

    .latest-strip-credit :global(i) {
      display: block;
      color: var(--text-soft);
      font: italic 1rem/1.4 var(--serif);
      letter-spacing: 0;
      white-space: nowrap;
    }

    .latest-strip-credit :global(.credit-tail) {
      margin-top: 0.2rem;
    }
  }

  @media (min-width: 350px) and (max-width: 640px) {
    .latest-strip-credit--paired {
      display: grid;
      grid-template-columns: minmax(0, 16fr) minmax(0, 9fr);
      gap: 0.875rem;
      align-items: start;
    }

    .latest-strip-credit--paired .latest-strip-credit-line {
      margin-top: 0;
    }

    .latest-strip-credit--paired :global(i) {
      font-size: 0.9375rem;
      white-space: normal;
    }
  }

  @media screen and (min-width: 350px) and (max-width: 640px) and (prefers-reduced-motion: no-preference) {
    .latest-strip-credit--paired :global(.publication-heartbeat-reserve) {
      display: block;
    }
  }
</style>
